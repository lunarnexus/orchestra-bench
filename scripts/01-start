#!/bin/sh
set -eu
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
usage: 01-start

Set up the benchmark container (build, recreate, configure).

Examples:
  scripts/01-start
  ./01-start
EOF
    exit 0
    ;;
esac
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(dirname -- "$SCRIPT_DIR")
cd "$REPO_ROOT"
exec python3 -m bench.cli start "$@"
