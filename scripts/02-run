#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(dirname -- "$SCRIPT_DIR")
cd "$REPO_ROOT"

first_positional=
after_double_dash=0
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    skip_next=0
    continue
  fi
  if [ "$after_double_dash" -eq 1 ]; then
    first_positional=$arg
    break
  fi
  case "$arg" in
    --)
      after_double_dash=1
      ;;
    --tasks-root|--root|--catalog|--run-id|--role|--notes|--catalog-label)
      skip_next=1
      ;;
    --auto|--dry-run|--verbose|--orchestra|--no-orchestra)
      ;;
    -*)
      ;;
    *)
      first_positional=$arg
      break
      ;;
  esac
done

case "$first_positional" in
  pi|opencode|hermes)
    exec python3 -m bench.cli exec "$@"
    ;;
esac

case " $* " in
  *" --help "*|*" -h "*|*" help "*)
    exec python3 -m bench.cli run "$@"
    ;;
esac

case " $* " in
  *" --auto "*)
    exec python3 -m bench.cli run "$@"
    ;;
esac

printf '%s\n' "error: scripts/02-run requires --auto for benchmark runs; use scripts/02-run --auto <task-or-suite>, or scripts/02-run pi|opencode|hermes <args...> for in-container harness passthrough" >&2
exit 1
