#!/usr/bin/env bash
# 02-open-pi — Prepare a task run, then open Pi interactively inside the benchmark container.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SCRIPT_DIR/.."
CONTAINER_NAME="orchestra-bench-runner"

usage() {
  cat <<EOF
Usage: $(basename "$0") <task-id> [--auto] [--no-orchestra] [--notes <text>]
       $(basename "$0") --list
       $(basename "$0") config

Open Pi for one benchmark task. A fresh run id and isolated workdir are created
automatically. The parent Pi session uses the catalog-derived model for the default parent role.

Use --auto to run Pi non-interactively with Prompt.md and exit. By default,
--auto first runs /orch on, then continues the same Pi session with the task
prompt. For role-focused tasks, --auto asks the parent session to dispatch the
target Orchestra role.

Commands:
  --auto       Run Pi with Prompt.md in non-interactive print mode and exit
  --no-orchestra Skip the automatic /orch on preflight for baseline/debug runs
  --notes      Free-form run notes stored in .bench_run.json
  --list   List tasks grouped by suite/role
  config   Open Pi's package/resource config TUI inside the benchmark container

Examples:
  scripts/02-open-pi --list
  scripts/02-open-pi config
  scripts/02-open-pi smoke-public-admin-handoff
  scripts/02-open-pi smoke-dependent-setup-chain --auto
EOF
}

_yaml_value() {
  python3 - "$1" "$2" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1]); key = sys.argv[2]
for line in path.read_text().splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith('#') or ':' not in stripped:
        continue
    k, v = stripped.split(':', 1)
    if k.strip() == key:
        print(v.strip().strip('"'))
        break
PY
}

list_tasks() {
  python3 - "$ROOT/tasks" <<'PY'
from pathlib import Path
import collections
base = Path(__import__('sys').argv[1])
rows = []
for y in sorted(base.glob('*/task.yaml')):
    data = {}
    for line in y.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith('#') or ':' not in s:
            continue
        k, v = s.split(':', 1)
        data[k.strip()] = v.strip().strip('"')
    rows.append(data)

order = ['smoke', 'role-focused', 'capability-easy', 'capability-normal', 'capability-advanced']
by_batch = collections.defaultdict(list)
for r in rows:
    by_batch[r.get('batch','')].append(r)

for batch in order:
    items = by_batch.get(batch, [])
    print(f"\n[{batch}]")
    if not items:
        print("  (no tasks yet)")
        continue
    if batch == 'role-focused':
        by_role = collections.defaultdict(list)
        for r in items:
            by_role[r.get('family','')].append(r)
        for role in ['planner','researcher','verifier','reviewer','builder','appsec']:
            role_items = sorted(by_role.get(role, []), key=lambda x: x.get('task_id',''))
            if not role_items:
                continue
            print(f"  {role}:")
            for r in role_items:
                print(f"    {r.get('task_id',''):<34} {r.get('description','')}")
    else:
        for r in sorted(items, key=lambda x: x.get('task_id','')):
            fam = r.get('family','')
            label = f"/{fam}" if fam and fam != batch else ''
            print(f"  {r.get('task_id',''):<36} ({batch}{label}) {r.get('description','')}")
PY
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --list) list_tasks; exit 0 ;;
  config)
    if ! docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" >/dev/null 2>&1; then
      echo "[bench] container not running — run 'scripts/01-start start' first" >&2
      exit 1
    fi
    exec docker exec -it "$CONTAINER_NAME" bash -lc "cd /workspace && exec pi config"
    ;;
esac

auto=false
auto_orch_on=true
run_notes="${BENCH_NOTES:-}"

task_id="${1:-}"
if [ -z "$task_id" ]; then
  echo "[bench] task id required — run 'scripts/02-open-pi --list'" >&2
  usage
  exit 1
fi
shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --auto) auto=true; shift ;;
    --no-orchestra) auto_orch_on=false; shift ;;
    --notes) run_notes="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[bench] unexpected argument: $1" >&2; usage; exit 1 ;;
  esac
done

TASK_DIR="$ROOT/tasks/$task_id"
TASK_YAML="$TASK_DIR/task.yaml"
if [ ! -f "$TASK_YAML" ]; then
  echo "[bench] task not found: $task_id" >&2
  echo "[bench] available tasks:" >&2
  list_tasks >&2
  exit 1
fi

if ! docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" >/dev/null 2>&1; then
  echo "[bench] container not running — run 'scripts/01-start start' first" >&2
  exit 1
fi

BENCH_RUN_ID="$(date +%Y%m%dT%H%M%S)"
export BENCH_RUN_ID BENCH_TASK_ID="$task_id"

family="$(_yaml_value "$TASK_YAML" family || true)"
batch="$(_yaml_value "$TASK_YAML" batch || true)"
parent_role="builder"
target_role=""
case "$family" in
  planner|researcher|verifier|reviewer|builder|appsec) target_role="$family" ;;
esac

prepare_orchestra_arg=""
if $auto; then
  if $auto_orch_on; then
    prepare_orchestra_arg="--orchestra"
  else
    prepare_orchestra_arg="--no-orchestra"
  fi
fi

echo "[bench] preparing task run..."
auto_json="false"
if $auto; then auto_json="true"; fi
BENCH_AUTO_JSON="$auto_json" BENCH_TARGET_ROLE="$target_role" BENCH_NOTES="$run_notes" "$ROOT/scripts/_prepare-task-run" "$task_id" --run-id "$BENCH_RUN_ID" --role "$parent_role" $prepare_orchestra_arg

config_path="$ROOT/results/$BENCH_RUN_ID-$task_id/.bench_run.json"
model_to_use=""
if [ -f "$config_path" ]; then
  model_to_use=$(python3 -c "import json; print(json.load(open('$config_path')).get('model',''))") || true
fi

WORKDIR="/workspace/$BENCH_RUN_ID-$task_id"
PROMPT_MD="$WORKDIR/Prompt.md"

echo "[bench] task:   $task_id"
echo "[bench] run:    $BENCH_RUN_ID"
echo "[bench] role:   $parent_role"
if [ -n "$target_role" ]; then
  echo "[bench] target: $target_role"
fi
echo "[bench] model:  ${model_to_use:-<default>}"
echo "[bench] collect: scripts/03-collect-results $task_id --run-id $BENCH_RUN_ID"

# Keep benchmark prompts task-local and concise. Prompt.md contains all
# role/task-specific instructions. --auto may still run an explicit /orch on
# preflight when enabled, but the harness does not prepend prompt text.

if $auto; then
  echo "[bench] auto:   running Prompt.md with pi -p"
  if $auto_orch_on; then
    echo "[bench] orch:   /orch on preflight enabled"
  else
    echo "[bench] orch:   /orch on preflight skipped"
  fi
  auto_orch_on_value="false"
  if $auto_orch_on; then auto_orch_on_value="true"; fi

  set +e
  docker exec \
    -e BENCH_RUN_ID="$BENCH_RUN_ID" \
    -e BENCH_TASK_ID="$task_id" \
    -e BENCH_WORKDIR="$WORKDIR" \
    -e BENCH_MODEL="$model_to_use" \
    -e BENCH_AUTO_ORCH_ON="$auto_orch_on_value" \
    "$CONTAINER_NAME" sh -c '
      set -eu
      cleanup_run_processes() {
        cd / 2>/dev/null || true
        workdir=${BENCH_WORKDIR%/}
        [ -n "$workdir" ] || return 0
        [ "$workdir" != "/" ] || return 0
        me=$$
        parent=${PPID:-}
        pids=""
        for f in /proc/[0-9]*/cwd; do
          pid=${f#/proc/}; pid=${pid%/cwd}
          [ "$pid" = "$me" ] && continue
          [ -n "$parent" ] && [ "$pid" = "$parent" ] && continue
          cwd=$(readlink "$f" 2>/dev/null || true)
          case "$cwd" in
            "$workdir"|"$workdir"/*) pids="$pids $pid" ;;
          esac
        done
        [ -n "$pids" ] || return 0
        echo "[bench] cleanup: stopping leaked run processes:$pids" >&2
        for pid in $pids; do kill "$pid" 2>/dev/null || true; done
        sleep 1
        for pid in $pids; do [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null || true; done
      }
      trap cleanup_run_processes EXIT
      cd "$BENCH_WORKDIR"
      if [ -f Prompt.md ]; then
        prompt=$(cat Prompt.md)
      elif [ -f PRD.md ]; then
        prompt="Read PRD.md, inspect the fixture, implement the requested behavior, and leave the workspace in a runnable state."
      else
        prompt="Inspect the workspace and complete the benchmark task."
      fi
      if [ "$BENCH_AUTO_ORCH_ON" = "true" ]; then
        pi --model "$BENCH_MODEL" -p "/orch on"
        pi --continue --model "$BENCH_MODEL" -p "$prompt"
        exit $?
      fi
      pi --model "$BENCH_MODEL" -p "$prompt"
    '
  pi_status=$?
  set -e
  "$ROOT/scripts/_cleanup-run-processes" "$task_id" --run-id "$BENCH_RUN_ID" || true
  "$ROOT/scripts/03-collect-results" "$task_id" --run-id "$BENCH_RUN_ID"
  exit "$pi_status"
fi

set +e
if docker exec "$CONTAINER_NAME" test -f "$PROMPT_MD"; then
  docker exec -it \
    -e BENCH_RUN_ID="$BENCH_RUN_ID" \
    -e BENCH_TASK_ID="$task_id" \
    "$CONTAINER_NAME" bash -c "
      cd $WORKDIR && \
      echo '=== Task: $task_id ===' && \
      cat $PROMPT_MD && \
      echo '' && \
      echo '--- Starting Pi in workdir: $WORKDIR ---' && \
      exec pi --model '$model_to_use'
    "
  pi_status=$?
else
  docker exec -it \
    -e BENCH_RUN_ID="$BENCH_RUN_ID" \
    -e BENCH_TASK_ID="$task_id" \
    "$CONTAINER_NAME" bash -c "cd $WORKDIR && echo '=== Task: $task_id (no Prompt.md) ===' && exec pi --model '$model_to_use'"
  pi_status=$?
fi
set -e
"$ROOT/scripts/_cleanup-run-processes" "$task_id" --run-id "$BENCH_RUN_ID" || true
"$ROOT/scripts/03-collect-results" "$task_id" --run-id "$BENCH_RUN_ID"
exit "$pi_status"
