#!/usr/bin/env bash
# 05-results — Historical benchmark reporting, plus guarded result maintenance.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SCRIPT_DIR/.."

usage() {
  cat <<EOF
Usage: $(basename "$0") [view] [options]

Views:
  dashboard        Default: overview, per-suite breakdown, per-test breakdown
  runs             List historical graded runs
  run <id|dir>     Show one run in detail
  debug <id|dir>   Show one run detail plus captured debug/session traces
  tasks            Task pass/fail breakdown
  timeline         Results over time
  tokens           Token usage across runs/tasks
  timing           Elapsed time across tasks/roles
  notes            List distinct run notes (sort/uniq style)
  configs          List discovered result configurations
  compare          Compare grouped configurations
  delete           Delete graded result directories matching filters (requires at least one filter; dry-run unless --yes)
  set-notes        Rewrite notes for graded results matching filters (requires at least one filter and --set-notes; dry-run unless --yes)

Options:
  --task <id>         Filter to one task
  --suite <name>      Filter to one suite/batch/family
  --notes <text>      Filter runs by notes substring match
  --model <text>      Filter by model substring/pattern text
  --plugins <list>    Filter by enabled run plugin substrings; negate with !name, -name, or not:name
  --without-plugins <list>
                     Exclude enabled run plugin substrings without shell-sensitive ! syntax
  --skills <list>     Filter by auxiliary skill name substrings; negate with !name, -name, or not:name
  --without-skills <list>
                     Exclude auxiliary skill substrings without shell-sensitive ! syntax
  --orchestra         Filter to runs with actual Orchestra dispatch/activity
  --no-orchestra      Filter to runs with no actual Orchestra dispatch/activity
  --detail <1|2|3>    Dashboard detail level (default: 3)
  --rubric [names]    Show only rubric breakdowns; optional comma-separated names
  --checks [names]    Show only check breakdowns; optional comma-separated names
  --behaviors [names] Show only behavior breakdowns; optional comma-separated names
  --limit <n>         Limit rows for runs/timeline (default: 20)
  --group-by <list>   Compare grouping fields: model,plugins,orchestra,skills,suite,task
  --configs <ids>     Compare only config ids from the configs view, e.g. C01,C02
  --per-task          In compare view, also show per-task rows
  --set-notes <text>  New notes text for the set-notes view
  --yes               Apply delete/set-notes changes (default is dry-run)

Examples:
  scripts/05-results
  scripts/05-results runs --limit 50
  scripts/05-results run 20260810T004753-smoke-dependent-setup-chain
  scripts/05-results run 20260810T004753
  scripts/05-results tasks
  scripts/05-results timeline --task smoke-dependent-setup-chain
  scripts/05-results tokens
  scripts/05-results timing
  scripts/05-results delete --model "3.8-27b"       # dry-run preview
  scripts/05-results delete --model "3.8-27b" --yes # delete matched run dirs
  scripts/05-results set-notes --notes "Batch1" --set-notes "Batch1 qwen3.6-35b"       # dry-run
  scripts/05-results set-notes --notes "Batch1" --set-notes "Batch1 qwen3.6-35b" --yes # rewrite notes
EOF
}

view="dashboard"
if [ $# -gt 0 ]; then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    dashboard|runs|run|debug|tasks|timeline|tokens|timing|notes|configs|compare|delete|set-notes) view="$1"; shift ;;
  esac
fi

run_query=""
task_filter=""
suite_filter=""
notes_filter=""
model_filter=""
plugins_filter=""
skills_filter=""
orchestra_filter="false"
no_orchestra_filter="false"
group_by="model,orchestra,plugins,skills"
configs_filter=""
per_task="false"
detail_level="3"
rubric_filter=""
checks_filter=""
behaviors_filter=""
limit="20"
yes_delete="false"
new_notes=""

if [ "$view" = "run" ] || [ "$view" = "debug" ]; then
  run_query="${1:-}"
  [ -n "$run_query" ] || { usage; exit 1; }
  shift || true
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --task) task_filter="$2"; shift 2 ;;
    --suite) suite_filter="$2"; shift 2 ;;
    --notes) notes_filter="$2"; shift 2 ;;
    --model) model_filter="$2"; shift 2 ;;
    --plugins) plugins_filter="$2"; shift 2 ;;
    --without-plugins) plugins_filter="${plugins_filter:+$plugins_filter }not:$2"; shift 2 ;;
    --skills) skills_filter="$2"; shift 2 ;;
    --without-skills) skills_filter="${skills_filter:+$skills_filter }not:$2"; shift 2 ;;
    --orchestra) orchestra_filter="true"; shift ;;
    --no-orchestra) no_orchestra_filter="true"; shift ;;
    --group-by) group_by="$2"; shift 2 ;;
    --configs) configs_filter="$2"; shift 2 ;;
    --per-task) per_task="true"; shift ;;
    --detail) detail_level="$2"; shift 2 ;;
    --rubric)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then rubric_filter="$2"; shift 2
      else rubric_filter="__all__"; shift
      fi ;;
    --checks)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then checks_filter="$2"; shift 2
      else checks_filter="__all__"; shift
      fi ;;
    --behaviors)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then behaviors_filter="$2"; shift 2
      else behaviors_filter="__all__"; shift
      fi ;;
    --limit) limit="$2"; shift 2 ;;
    --set-notes) new_notes="$2"; shift 2 ;;
    --yes) yes_delete="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[bench] unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

python3 - "$ROOT" "$view" "$run_query" "$task_filter" "$suite_filter" "$notes_filter" "$model_filter" "$plugins_filter" "$skills_filter" "$orchestra_filter" "$no_orchestra_filter" "$group_by" "$configs_filter" "$per_task" "$detail_level" "$rubric_filter" "$checks_filter" "$behaviors_filter" "$limit" "$yes_delete" "$new_notes" <<'PY'
from __future__ import annotations

import json
import os
import shutil
import statistics
import sys
import textwrap
from collections import defaultdict
from pathlib import Path

ANSI = {
    "red": "\033[31m",
    "green": "\033[32m",
    "reset": "\033[0m",
}
COLOR_ENABLED = (sys.stdout.isatty() or bool(os.environ.get("FORCE_COLOR"))) and not bool(os.environ.get("NO_COLOR"))

root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))
from __init__ import TaskResult
from eval_harness import format_efficiency_summary, format_rubric_summary, orchestration_warnings

view = sys.argv[2]
run_query = sys.argv[3]
task_filter = sys.argv[4]
suite_filter = sys.argv[5].strip().lower()
notes_filter = sys.argv[6].strip().lower()
model_filter = sys.argv[7].strip().lower()
plugins_filter = sys.argv[8].strip()
skills_filter = sys.argv[9].strip()
orchestra_filter = sys.argv[10].strip().lower() == "true"
no_orchestra_filter = sys.argv[11].strip().lower() == "true"
group_by_raw = sys.argv[12].strip()
configs_filter = sys.argv[13].strip()
per_task = sys.argv[14].strip().lower() == "true"
try:
    detail_level = int(sys.argv[15])
except Exception:
    detail_level = 3
if detail_level not in (1, 2, 3):
    detail_level = 3
rubric_filter = sys.argv[16].strip()
checks_filter = sys.argv[17].strip()
behaviors_filter = sys.argv[18].strip()
try:
    limit = int(sys.argv[19])
except Exception:
    limit = 20
# Debug traces should be complete by default. Use --limit N to tail the raw Pi
# fallback trace when a bounded view is explicitly desired.
if view == "debug" and limit == 20:
    limit = 0
yes_delete = sys.argv[20].strip().lower() == "true"
new_notes = sys.argv[21]

results_dir = root / "results"
tasks_dir = root / "tasks"

current_tasks = set()
for y in tasks_dir.glob("*/task.yaml"):
    task_id = y.parent.name
    for line in y.read_text().splitlines():
        s = line.strip()
        if s.startswith("task_id:"):
            task_id = s.split(":", 1)[1].strip().strip('"')
            break
    current_tasks.add(task_id)


def _split_filter_terms(raw):
    terms = []
    for chunk in str(raw or "").replace(",", " ").split():
        term = chunk.strip()
        if term:
            terms.append(term)
    return terms


def _split_positive_negative(raw):
    include = []
    exclude = []
    for term in _split_filter_terms(raw):
        lower = term.lower()
        if lower.startswith("not:") and len(term) > 4:
            exclude.append(lower[4:])
        elif term.startswith("!") and len(term) > 1:
            exclude.append(term[1:].lower())
        elif term.startswith("-") and len(term) > 1:
            exclude.append(term[1:].lower())
        else:
            include.append(lower)
    return include, exclude


def _normalize_filter_text(value):
    return "".join(ch for ch in str(value or "").lower() if ch.isalnum())


def _contains_term(values, term):
    term = str(term or "").lower()
    if not term:
        return True
    value_texts = [str(value or "").lower() for value in values]
    combined = ",".join(value_texts)
    if term in combined or any(term in value for value in value_texts):
        return True
    normalized_term = _normalize_filter_text(term)
    normalized_values = [_normalize_filter_text(value) for value in value_texts]
    normalized_combined = _normalize_filter_text(combined)
    return bool(normalized_term) and (
        normalized_term in normalized_combined
        or any(normalized_term in value for value in normalized_values)
    )


def _model_text(meta):
    return str(meta.get("model", "") or "")


def _skill_values(meta):
    values = []
    raw = meta.get("extra_skills")
    if isinstance(raw, list):
        values.extend(str(v).strip() for v in raw if str(v).strip())
    for key in ("aux_skill_names",):
        raw = meta.get(key)
        if isinstance(raw, list):
            values.extend(str(v).strip() for v in raw if str(v).strip())
    summary = str(meta.get("aux_skills_summary", "") or "")
    if summary and summary != "none":
        values.extend(part.strip() for part in summary.split(",") if part.strip())
    return sorted(set(values))


def _plugin_values(meta):
    values = []
    raw = meta.get("pi_enabled_plugins")
    if isinstance(raw, list):
        values.extend(str(v).strip() for v in raw if str(v).strip())
    summary = str(meta.get("pi_enabled_plugins_summary", "") or "")
    if summary and summary != "none":
        values.extend(part.strip() for part in summary.split(",") if part.strip())

    # Backward-compatible fallback for older result JSONs that predate enabled
    # plugin capture. This is less precise: it means installed/loaded extension.
    if not values:
        raw = meta.get("pi_extensions")
        if isinstance(raw, list):
            values.extend(str(v).strip() for v in raw if str(v).strip())
        summary = str(meta.get("pi_extensions_summary", "") or "")
        if summary and summary != "none":
            values.extend(part.strip() for part in summary.split(",") if part.strip())
    return sorted(set(values))


def _list_filter_matches(values, raw):
    include, exclude = _split_positive_negative(raw)
    if include and not all(_contains_term(values, term) for term in include):
        return False
    if exclude and any(_contains_term(values, term) for term in exclude):
        return False
    return True


def _plugins_filter_excludes_orchestra():
    _include, exclude = _split_positive_negative(plugins_filter)
    return any(_contains_term(["orchestra"], term) for term in exclude)


def _orchestra_used(r):
    checks = r.get("orchestration_checks") or {}
    dispatch_count = checks.get("dispatch_count")
    if isinstance(dispatch_count, (int, float)) and dispatch_count > 0:
        return True
    if checks.get("no_orchestration") is False:
        return True
    if checks.get("no_orchestration") is True:
        return False
    # Older results may not have orchestration_checks; fall back to harness intent.
    meta = r.get("run_meta") or {}
    return meta.get("orchestra") is True


def _orchestra_activity_label(r):
    return "used" if _orchestra_used(r) else "none"


def meta_matches_filters(r):
    meta = r.get("run_meta") or {}
    if model_filter and model_filter not in _model_text(meta).lower():
        return False
    if orchestra_filter and not _orchestra_used(r):
        return False
    if no_orchestra_filter and _orchestra_used(r):
        return False
    if plugins_filter and not _list_filter_matches(_plugin_values(meta), plugins_filter):
        return False
    if skills_filter and not _list_filter_matches(_skill_values(meta), skills_filter):
        return False
    return True


def prepared_only_runs():
    out = []
    if not results_dir.is_dir():
        return out
    for p in sorted(results_dir.glob("*/.bench_run.json")):
        if not (p.parent / "result.json").exists():
            try:
                d = json.loads(p.read_text())
            except Exception:
                continue
            task_id = d.get("task_id", "")
            if current_tasks and task_id not in current_tasks:
                continue
            if task_filter and task_id != task_filter:
                continue
            suite = str(d.get("batch", d.get("family", "")) or "").strip().lower()
            if suite_filter and suite_filter != suite:
                continue
            notes = str(d.get("notes", "") or "")
            if notes_filter and notes_filter not in notes.lower():
                continue
            if not meta_matches_filters({"run_meta": d, "task_meta": {"batch": suite}}):
                continue
            d["_dir"] = str(p.parent.relative_to(root))
            out.append(d)
    return out


def load_results():
    rows = []
    if not results_dir.is_dir():
        return rows
    for p in sorted(results_dir.glob("*/result.json")):
        try:
            d = json.loads(p.read_text())
        except Exception:
            continue
        task_id = d.get("task_id", "")
        if current_tasks and task_id not in current_tasks:
            continue
        if task_filter and task_id != task_filter:
            continue
        suite = suite_name(d).strip().lower()
        if suite_filter and suite_filter != suite:
            continue
        notes = str(((d.get("run_meta") or {}).get("notes", "")) or "")
        if notes_filter and notes_filter not in notes.lower():
            continue
        if not meta_matches_filters(d):
            continue
        d["_dir"] = str(p.parent.relative_to(root))
        d["_path"] = str(p.relative_to(root))
        d["_mtime"] = p.stat().st_mtime
        rows.append(d)
    rows.sort(key=lambda r: (str(r.get("run_id", "")), str(r.get("task_id", ""))))
    return rows


def token_total(r):
    t = r.get("tokens") or {}
    all_sessions = t.get("all_sessions")
    if isinstance(all_sessions, dict):
        v = all_sessions.get("total_tokens")
        if isinstance(v, (int, float)):
            return int(v)
    return 0


def _safe_int(value):
    """Extract a safe integer from a value, defaulting to 0."""
    if isinstance(value, (int, float)):
        return int(value)
    return 0


def token_parts(r):
    t = r.get("tokens") or {}
    all_sessions = t.get("all_sessions") if isinstance(t.get("all_sessions"), dict) else {}
    return {
        "input": _safe_int(all_sessions.get("input_tokens")),
        "output": _safe_int(all_sessions.get("output_tokens")),
        "reasoning": _safe_int(all_sessions.get("reasoning_tokens")),
        "cached_read": _safe_int(all_sessions.get("cached_input_read_tokens")),
        "cache_write": _safe_int(all_sessions.get("cache_write_tokens")),
        "total": token_total(r),
    }


def main_context_input(r):
    t = r.get("tokens") or {}
    v = t.get("main_session_context_input_tokens")
    return int(v) if isinstance(v, (int, float)) else 0


def main_context_max_input(r):
    t = r.get("tokens") or {}
    v = t.get("main_session_max_input_tokens", t.get("main_session_max_total_tokens"))
    return int(v) if isinstance(v, (int, float)) else 0


def main_api_call_count(r):
    t = r.get("tokens") or {}
    v = t.get("main_session_api_call_count")
    return int(v) if isinstance(v, (int, float)) else 0


def main_active_worker_tokens(r):
    t = r.get("tokens") or {}
    v = t.get("main_active_worker_tokens")
    return int(v) if isinstance(v, (int, float)) else 0


def main_active_worker_api_calls(r):
    t = r.get("tokens") or {}
    v = t.get("main_active_worker_api_calls")
    return int(v) if isinstance(v, (int, float)) else 0


def _format_count_mapping(mapping):
    if not isinstance(mapping, dict) or not mapping:
        return ""
    parts = []
    for key in sorted(mapping):
        value = mapping.get(key)
        if isinstance(value, (int, float)):
            parts.append(f"{key}={int(value):,}")
    return ", ".join(parts)


def compaction_count(r):
    """Get compaction count from tokens dict (ingested from artifacts)."""
    t = r.get("tokens") or {}
    v = t.get("compaction_count")
    return int(v) if isinstance(v, (int, float)) else 0


def _get_exp_main_tokens(r):
    """Extract expensive main session total tokens dict."""
    t = r.get("tokens") or {}
    exp = t.get("expensive_main_session_tokens")
    if isinstance(exp, dict) and exp:
        return exp
    main = t.get("main_session")
    if isinstance(main, dict) and main:
        return main
    return {}


def _get_cheap_role_tokens(r):
    """Extract cheap role tokens dict."""
    t = r.get("tokens") or {}
    cheap = t.get("cheap_role_tokens")
    if isinstance(cheap, dict) and cheap:
        return cheap
    return {}


def exp_main_total(r):
    """Total tokens for expensive main session."""
    exp = _get_exp_main_tokens(r)
    v = exp.get("total_tokens")
    if isinstance(v, (int, float)) and v > 0:
        return int(v)
    return 0


def cheap_role_total(r):
    """Total tokens for cheap role sessions."""
    cheap = _get_cheap_role_tokens(r)
    v = cheap.get("total_tokens")
    if isinstance(v, (int, float)) and v > 0:
        return int(v)
    return 0


def has_classified_tokens(r):
    """Check if result has classified token data."""
    t = r.get("tokens") or {}
    return bool(t.get("expensive_main_session_tokens") or t.get("cheap_role_tokens"))


def _fmt_token_line(label, value):
    """Format a single token metric line with commas for large numbers."""
    if not value:
        return f"{label:<20}: -"
    return f"{label:<20}: {value:,}"


def elapsed(r):
    v = r.get("elapsed_seconds")
    return float(v) if isinstance(v, (int, float)) else 0.0


def fmt_seconds(value):
    if not value:
        return "-"
    if value < 60:
        return f"{value:.0f}s"
    return f"{value/60:.1f}m"


def colorize(text, color):
    if not COLOR_ENABLED:
        return text
    code = ANSI.get(color)
    if not code:
        return text
    return f"{code}{text}{ANSI['reset']}"


def color_pass_fail(text, passed):
    return colorize(text, "green" if passed else "red")


def color_bool_value(value):
    if value is True:
        return colorize("True", "green")
    if value is False:
        return colorize("False", "red")
    return str(value)


def color_for_rate(text, numerator, denominator):
    if denominator <= 0:
        return text
    if numerator == denominator:
        return colorize(text, "green")
    if numerator == 0:
        return colorize(text, "red")
    return text


def color_for_behavior_rate(name, text, numerator, denominator):
    if denominator <= 0:
        return text
    positive_when_true = {
        "target_role_dispatched",
        "worker_completed",
    }
    negative_when_true = {
        "premature_completion",
        "fallback_answer_after_dispatch",
        "worker_running_without_exit",
        "missing_expected_role",
        "no_orchestration",
        "process_penalty_applied",
    }
    name = str(name or "")
    if name in positive_when_true:
        return color_for_rate(text, numerator, denominator)
    if name in negative_when_true:
        if numerator == 0:
            return colorize(text, "green")
        if numerator == denominator:
            return colorize(text, "red")
        return text
    return text


def color_for_behavior_count(name, text, total):
    name = str(name or "")
    bad_when_nonzero = {
        "timeouts",
        "retries",
        "scope_blockers",
        "same_slice_redispatches",
    }
    if name in bad_when_nonzero:
        if total == 0:
            return colorize(text, "green")
        return colorize(text, "red")
    return text


def status(r):
    return color_pass_fail("PASS" if r.get("score") == "pass" else "FAIL", r.get("score") == "pass")


def _parse_name_filter(raw):
    raw = str(raw or "").strip()
    if not raw:
        return None
    if raw == "__all__":
        return []
    return [part.strip().lower() for part in raw.split(",") if part.strip()]


rubric_names = _parse_name_filter(rubric_filter)
check_names = _parse_name_filter(checks_filter)
behavior_names = _parse_name_filter(behaviors_filter)
section_only_mode = any(x is not None for x in (rubric_names, check_names, behavior_names))


def _name_selected(name, selected):
    if selected is None:
        return False
    if selected == []:
        return True
    lowered = str(name or "").strip().lower()
    return lowered in selected


def suite_name(r):
    task_meta = r.get("task_meta") or {}
    batch = str(task_meta.get("batch", "") or "").strip()
    family = str(task_meta.get("family", "") or "").strip()
    if batch:
        return batch
    if family and family != "default":
        return family
    return "unbatched"


def numeric_scores(rows):
    vals = []
    for r in rows:
        v = r.get("score_numeric")
        if isinstance(v, (int, float)):
            vals.append(float(v))
    return vals


def bool_check_rate(rows, key):
    vals = []
    for r in rows:
        checks = r.get("checks") or {}
        if isinstance(checks.get(key), bool):
            vals.append(bool(checks.get(key)))
    if not vals:
        return None
    return sum(1 for v in vals if v) / len(vals)


def aggregate_rubric(rows):
    by_cat = defaultdict(list)
    total_pairs = []
    for r in rows:
        rubric = r.get("rubric") or {}
        run_score = 0.0
        run_max = 0.0
        has_any = False
        for name, value in rubric.items():
            if not isinstance(value, dict):
                continue
            score = value.get("score")
            max_score = value.get("max")
            if isinstance(score, (int, float)) and isinstance(max_score, (int, float)):
                score_f = float(score)
                max_f = float(max_score)
                by_cat[str(name)].append((score_f, max_f))
                run_score += score_f
                run_max += max_f
                has_any = True
        if has_any:
            total_pairs.append((run_score, run_max))
    out = []
    for name in sorted(by_cat):
        vals = by_cat[name]
        avg_score = statistics.mean(v[0] for v in vals)
        avg_max = statistics.mean(v[1] for v in vals)
        pct = (avg_score / avg_max * 100.0) if avg_max else 0.0
        out.append((name, avg_score, avg_max, pct, len(vals)))
    return out, total_pairs


def aggregate_bool_checks(rows):
    keys = set()
    for r in rows:
        checks = r.get("checks") or {}
        for key, value in checks.items():
            if isinstance(value, bool):
                keys.add(str(key))
    out = []
    for key in sorted(keys):
        rate = bool_check_rate(rows, key)
        if rate is None:
            continue
        out.append((key, rate, sum(1 for r in rows if isinstance((r.get("checks") or {}).get(key), bool))))
    return out


def aggregate_orchestration(rows):
    metrics = {}
    numeric_keys = (
        "compaction_count",
        "dispatch_count",
        "timeouts",
        "retries",
        "scope_blockers",
        "same_slice_redispatches",
    )
    bool_keys = (
        "target_role_dispatched",
        "worker_completed",
        "worker_running_without_exit",
        "fallback_answer_after_dispatch",
        "premature_completion",
        "missing_expected_role",
        "no_orchestration",
        "process_penalty_applied",
    )
    for key in numeric_keys:
        vals = []
        for r in rows:
            checks = r.get("orchestration_checks") or {}
            v = checks.get(key, 0)
            if isinstance(v, (int, float)):
                vals.append(float(v))
            else:
                vals.append(0.0)
        if vals:
            metrics[key] = {
                "kind": "numeric",
                "total": sum(vals),
                "avg": statistics.mean(vals),
                "high": max(vals),
                "low": min(vals),
                "count": len(vals),
            }
    for key in bool_keys:
        vals = []
        for r in rows:
            checks = r.get("orchestration_checks") or {}
            v = checks.get(key)
            if isinstance(v, bool):
                vals.append(v)
        if vals:
            true_count = sum(1 for v in vals if v)
            metrics[key] = {
                "kind": "bool",
                "true": true_count,
                "false": len(vals) - true_count,
                "rate": true_count / len(vals),
                "count": len(vals),
            }
    return metrics


def print_metric_line(label, values, *, integer=False, formatter=None, total=False):
    if not values:
        print(f"{label:<12}: none captured yet")
        return
    avg = statistics.mean(values)
    median = statistics.median(values)
    high = max(values)
    low = min(values)
    if formatter is None:
        if integer:
            formatter = lambda v: f"{int(v):,}"
        else:
            formatter = lambda v: str(v)
    parts = []
    if total:
        parts.append(f"total={formatter(sum(values))}")
    parts.extend([
        f"avg={formatter(avg)}",
        f"median={formatter(median)}",
        f"high={formatter(high)}",
        f"low={formatter(low)}",
    ])
    print(f"{label:<12}: {' '.join(parts)}")


def print_score_breakdown(rows, indent="  "):
    if not section_only_mode and detail_level >= 2:
        scores = numeric_scores(rows)
        if scores:
            print(f"{indent}score_numeric: avg={statistics.mean(scores):.4f} median={statistics.median(scores):.4f} high={max(scores):.4f} low={min(scores):.4f} n={len(scores)}")

    rubric_items, rubric_totals = aggregate_rubric(rows)
    rubric = rubric_items if rubric_names is None else [item for item in rubric_items if _name_selected(item[0], rubric_names)]
    if rubric_names is not None and rubric:
        print(f"{indent}rubric:")
        for name, avg_score, avg_max, pct, count in rubric:
            print(f"{indent}  - {name}: {avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={count}")
    elif not section_only_mode and rubric and detail_level >= 3:
        print(f"{indent}rubric:")
        for name, avg_score, avg_max, pct, count in rubric:
            print(f"{indent}  - {name}: {avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={count}")
    elif not section_only_mode and rubric_totals and detail_level == 2:
        scores_only = [v[0] for v in rubric_totals]
        max_only = [v[1] for v in rubric_totals]
        avg_score = statistics.mean(scores_only)
        avg_max = statistics.mean(max_only)
        pct = (avg_score / avg_max * 100.0) if avg_max else 0.0
        print(f"{indent}rubric       : avg={avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={len(rubric_totals)}")

    bool_checks = aggregate_bool_checks(rows) if check_names is None else [item for item in aggregate_bool_checks(rows) if _name_selected(item[0], check_names)]
    if check_names is not None and bool_checks:
        print(f"{indent}checks:")
        for key, rate, count in bool_checks:
            passed = int(round(rate * count))
            text = f"{rate*100:.0f}% pass ({passed}/{count})"
            print(f"{indent}  - {key}: {color_for_rate(text, passed, count)}")
    elif not section_only_mode and bool_checks and detail_level >= 3:
        print(f"{indent}checks:")
        for key, rate, count in bool_checks:
            passed = int(round(rate * count))
            text = f"{rate*100:.0f}% pass ({passed}/{count})"
            print(f"{indent}  - {key}: {color_for_rate(text, passed, count)}")
    elif not section_only_mode and bool_checks and detail_level == 2:
        avg_rate = statistics.mean(rate for _, rate, _ in bool_checks) * 100.0
        print(f"{indent}checks       : avg_pass_rate={avg_rate:.0f}% metrics={len(bool_checks)}")

    orchestration_all = aggregate_orchestration(rows)
    orchestration = orchestration_all if behavior_names is None else {k: v for k, v in orchestration_all.items() if _name_selected(k, behavior_names)}
    if behavior_names is not None and orchestration:
        print(f"{indent}behaviors:")
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                text = f"true={int(data['true'])} false={int(data['false'])} rate={data['rate']*100:.0f}%"
                print(f"{indent}  - {key}: {color_for_behavior_rate(key, text, int(data['true']), int(data['count']))}")
            else:
                text = f"total={int(data['total'])} avg={data['avg']:.2f} high={int(data['high'])} low={int(data['low'])}"
                print(f"{indent}  - {key}: {color_for_behavior_count(key, text, int(data['total']))}")
    elif not section_only_mode and orchestration and detail_level >= 3:
        print(f"{indent}behaviors:")
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                text = f"true={int(data['true'])} false={int(data['false'])} rate={data['rate']*100:.0f}%"
                print(f"{indent}  - {key}: {color_for_behavior_rate(key, text, int(data['true']), int(data['count']))}")
            else:
                text = f"total={int(data['total'])} avg={data['avg']:.2f} high={int(data['high'])} low={int(data['low'])}"
                print(f"{indent}  - {key}: {color_for_behavior_count(key, text, int(data['total']))}")
    elif not section_only_mode and orchestration and detail_level == 2:
        summary_parts = []
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                summary_parts.append(f"{key}={int(data['true'])}/{int(data['count'])}")
            else:
                summary_parts.append(f"{key}={int(data['total'])}")
        print(f"{indent}behaviors    : {', '.join(summary_parts)}")


def print_section_metrics(rows, indent=""):
    passed = sum(1 for r in rows if r.get("score") == "pass")
    failed = len(rows) - passed
    print(f"{indent}runs        : {len(rows)}")
    if rows:
        print(f"{indent}pass rate   : {color_for_rate(f'{passed}/{len(rows)}', passed, len(rows))}")
    else:
        print(f"{indent}pass rate   : n/a")
    toks = [token_total(r) for r in rows if token_total(r)]
    print_metric_line(f"{indent}tokens", toks, integer=True, total=True)

    # Main session tokens when classified data available
    exp_toks = [exp_main_total(r) for r in rows if exp_main_total(r)]
    if exp_toks:
        print_metric_line(f"{indent}main_tokens", exp_toks, integer=True, total=True)

    # Role tokens when classified data available
    role_toks = [cheap_role_total(r) for r in rows if cheap_role_total(r)]
    if role_toks:
        print_metric_line(f"{indent}role_tokens", role_toks, integer=True, total=True)

    context_tokens = [main_context_input(r) for r in rows if main_context_input(r)]
    print_metric_line(f"{indent}main_ctx_final", context_tokens, integer=True)

    # Max context when available and different from final
    ctx_max_vals = [max(main_context_input(r), main_context_max_input(r)) for r in rows
                    if main_context_input(r) or main_context_max_input(r)]
    print_metric_line(f"{indent}main_ctx_max", ctx_max_vals, integer=True)

    # API call count and compactions when available
    api_count = [main_api_call_count(r) for r in rows if main_api_call_count(r)]
    print_metric_line(f"{indent}api_calls", api_count, integer=True)

    active_worker_tokens = [main_active_worker_tokens(r) for r in rows if main_active_worker_tokens(r)]
    if active_worker_tokens:
        print_metric_line(f"{indent}main_active_worker_tokens", active_worker_tokens, integer=True, total=True)
    active_worker_api_calls = [main_active_worker_api_calls(r) for r in rows if main_active_worker_api_calls(r)]
    if active_worker_api_calls:
        print_metric_line(f"{indent}main_active_worker_api_calls", active_worker_api_calls, integer=True, total=True)

    parent_tool_totals = []
    parent_tool_categories = defaultdict(int)
    ownership_by_role = defaultdict(int)
    duplicate_counts = defaultdict(int)
    repeated_builder_tests = []
    repeated_worker_tests = []
    for r in rows:
        checks = r.get("orchestration_checks") or {}
        if not isinstance(checks, dict):
            continue
        parent_tools = checks.get("parent_tool_calls_while_workers_active")
        if isinstance(parent_tools, dict):
            total = parent_tools.get("total")
            if isinstance(total, (int, float)):
                parent_tool_totals.append(int(total))
            by_category = parent_tools.get("by_category")
            if isinstance(by_category, dict):
                for key, value in by_category.items():
                    if isinstance(value, (int, float)):
                        parent_tool_categories[str(key)] += int(value)
        ownership = checks.get("test_command_ownership_by_role")
        if isinstance(ownership, dict):
            for key, value in ownership.items():
                if isinstance(value, (int, float)):
                    ownership_by_role[str(key)] += int(value)
        duplicates = checks.get("duplicate_normalized_test_command_counts")
        if isinstance(duplicates, dict):
            for key, value in duplicates.items():
                if isinstance(value, (int, float)):
                    duplicate_counts[str(key)] += int(value)
        repeated = checks.get("verifier_repeated_builder_tests")
        if isinstance(repeated, (int, float)):
            repeated_builder_tests.append(int(repeated))
        repeated = checks.get("orchestrator_repeated_worker_tests")
        if isinstance(repeated, (int, float)):
            repeated_worker_tests.append(int(repeated))

    if parent_tool_totals:
        print_metric_line(f"{indent}parent_tool_calls_while_workers_active", parent_tool_totals, integer=True, total=True)
        category_text = _format_count_mapping(parent_tool_categories)
        if category_text:
            print(f"{indent}  categories  : {category_text}")
    if ownership_by_role:
        print(f"{indent}test_command_ownership_by_role: {_format_count_mapping(ownership_by_role)}")
    if duplicate_counts:
        print(f"{indent}duplicate_normalized_test_command_counts: {_format_count_mapping(duplicate_counts)}")
    if repeated_builder_tests:
        print_metric_line(f"{indent}verifier_repeated_builder_tests", repeated_builder_tests, integer=True, total=True)
    if repeated_worker_tests:
        print_metric_line(f"{indent}orchestrator_repeated_worker_tests", repeated_worker_tests, integer=True, total=True)

    compacations = [compaction_count(r) for r in rows if compaction_count(r)]
    if compacations:
        print(f"{indent}compactions   : total={int(sum(compacations)):,} avg={statistics.mean(compacations):.1f}")

    times = [elapsed(r) for r in rows if elapsed(r)]
    print_metric_line(f"{indent}elapsed", times, formatter=fmt_seconds, total=True)
    if detail_level >= 2 or section_only_mode:
        print_score_breakdown(rows, indent + "  ")


def find_run(rows, q):
    for r in rows:
        if q in {str(r.get("run_id", "")), f"{r.get('run_id')}-{r.get('task_id')}", r.get("_dir", "").split("/", 1)[-1]}:
            return r
    matches = [r for r in rows if q and (q in str(r.get("run_id", "")) or q in str(r.get("task_id", "")) or q in r.get("_dir", ""))]
    if len(matches) == 1:
        return matches[0]
    return None


def unique_meta_values(rows, key, *, default="(none)"):
    values = []
    seen = set()
    for r in rows:
        meta = r.get("run_meta") or {}
        value = meta.get(key)
        if isinstance(value, list):
            value_text = ",".join(str(v) for v in value) if value else default
        elif value is None or value == "":
            value_text = default
        else:
            value_text = str(value)
        if value_text not in seen:
            seen.add(value_text)
            values.append(value_text)
    return values


def render_command_args(meta):
    args = []
    if meta.get("auto") is True:
        args.append("--auto")
    if meta.get("orchestra") is False:
        args.append("--no-orchestra")
    return " ".join(args) if args else "(interactive/default)"


def render_extensions(meta):
    names = []
    seen = set()
    for key in ("pi_extensions", "pi_package_names"):
        raw = meta.get(key)
        if isinstance(raw, list):
            parts = [str(v).strip() for v in raw if str(v).strip()]
        else:
            parts = []
    
        for part in parts:
            if part not in seen:
                seen.add(part)
                names.append(part)

    for key in ("pi_extensions_summary", "pi_packages_summary"):
        raw = str(meta.get(key, "") or "")
        for part in [p.strip() for p in raw.split(",") if p.strip() and p.strip() != "none"]:
            if part not in seen:
                seen.add(part)
                names.append(part)

    return ",".join(names) if names else "(none)"


def render_orchestra_version(meta):
    version = str(meta.get("orchestra_version", "") or "").strip()
    rev = str(meta.get("orchestra_source_rev", "") or "").strip()
    dirty = meta.get("orchestra_source_dirty")
    if not version and not rev:
        return ""
    parts = []
    if version:
        parts.append(version)
    if rev and rev not in version:
        parts.append(f"rev={rev}")
    if dirty is True:
        parts.append("dirty")
    elif dirty is False and rev:
        parts.append("clean")
    return " ".join(parts)


def render_role_models_compact(meta):
    raw = meta.get("role_models")
    pairs = []
    if isinstance(raw, dict):
        pairs = [(str(role).strip(), str(model).strip()) for role, model in raw.items() if str(role).strip() and str(model).strip()]
    if not pairs:
        summary = str(meta.get("role_models_summary", "") or "").strip()
        for part in [p.strip() for p in summary.split(",") if p.strip() and "=" in p]:
            role, model = part.split("=", 1)
            role = role.strip()
            model = model.strip()
            if role and model:
                pairs.append((role, model))
    if not pairs:
        return ""
    grouped = defaultdict(list)
    for role, model in pairs:
        grouped[model.replace("lmstudio/", "")].append(role)
    chunks = []
    for model in sorted(grouped, key=lambda m: (-len(grouped[m]), m)):
        roles = ",".join(sorted(grouped[model]))
        chunks.append(f"{roles}={model}")
    return "; ".join(chunks)


def unique_command_args(rows):
    values = []
    seen = set()
    for r in rows:
        text = render_command_args(r.get("run_meta") or {})
        if text not in seen:
            seen.add(text)
            values.append(text)
    return values


def print_overview(rows):
    pending = prepared_only_runs()
    passed = sum(1 for r in rows if r.get("score") == "pass")
    failed = len(rows) - passed
    print("=== orchestra-bench results dashboard ===")
    if task_filter:
        print(f"task filter : {task_filter}")
    if suite_filter:
        print(f"suite filter: {suite_filter}")
    if notes_filter:
        print(f"notes filter: {notes_filter}")
    if model_filter:
        print(f"model filter: {model_filter}")
    if plugins_filter:
        print(f"plugins     : {plugins_filter}")
    if skills_filter:
        print(f"skills filt : {skills_filter}")
    if orchestra_filter:
        print("orchestra   : used")
    if no_orchestra_filter:
        print("orchestra   : not used")
    print(f"detail level: {detail_level}")
    if rubric_names is not None:
        print(f"rubric view : {'all' if rubric_names == [] else ', '.join(rubric_names)}")
    if check_names is not None:
        print(f"checks view : {'all' if check_names == [] else ', '.join(check_names)}")
    if behavior_names is not None:
        print(f"behaviors   : {'all' if behavior_names == [] else ', '.join(behavior_names)}")
    print(f"graded runs : {len(rows)}")
    if not rows and _plugins_filter_excludes_orchestra() and not no_orchestra_filter:
        print("hint        : --plugins -orchestra excludes runs with the Orchestra plugin enabled; use --no-orchestra to see only /orch-off runs")
    arg_vals = unique_command_args(rows)
    ext_vals = []
    seen_exts = set()
    for r in rows:
        ext_text = render_extensions(r.get("run_meta") or {})
        if ext_text not in seen_exts:
            seen_exts.add(ext_text)
            ext_vals.append(ext_text)
    skill_vals = unique_meta_values(rows, "aux_skills_summary")
    config_root_vals = []
    seen_config_roots = set()
    for r in rows:
        meta = r.get("run_meta") or {}
        catalog_path = str(meta.get("catalog_path", "") or "").strip()
        config_root = str(Path(catalog_path).parent if catalog_path else "").strip() or "(none)"
        if config_root not in seen_config_roots:
            seen_config_roots.add(config_root)
            config_root_vals.append(config_root)
    print(f"args        : {' | '.join(arg_vals)}")
    plugin_vals = []
    seen_plugins = set()
    for r in rows:
        plugin_text = ",".join(_plugin_values(r.get("run_meta") or {})) or "none"
        if plugin_text not in seen_plugins:
            seen_plugins.add(plugin_text)
            plugin_vals.append(plugin_text)
    print(f"extensions  : {' | '.join(ext_vals)}")
    print(f"plugins     : {' | '.join(plugin_vals)}")
    print(f"skills      : {' | '.join(skill_vals)}")
    print(f"config      : {' | '.join(config_root_vals)}")
    print(f"passed      : {colorize(str(passed), 'green') if passed else passed}")
    print(f"failed      : {colorize(str(failed), 'red') if failed else failed}")
    print(f"pass rate   : {color_for_rate(f'{passed}/{len(rows)}', passed, len(rows))}" if rows else "pass rate   : n/a")
    toks = [token_total(r) for r in rows if token_total(r)]
    print_metric_line("tokens", toks, integer=True, total=True)

    # Show classified main/role tokens when available in overview
    exp_toks = [exp_main_total(r) for r in rows if exp_main_total(r)]
    if exp_toks:
        print_metric_line("main_tokens", exp_toks, integer=True, total=True)
    role_toks = [cheap_role_total(r) for r in rows if cheap_role_total(r)]
    if role_toks:
        print_metric_line("role_tokens", role_toks, integer=True, total=True)

    times = [elapsed(r) for r in rows if elapsed(r)]
    print_metric_line("elapsed", times, formatter=fmt_seconds, total=True)
    if pending:
        print(f"ungraded    : {len(pending)} prepared run(s); grade with scripts/03-collect-results <task-id>")
        for r in pending[-5:][::-1]:
            print(f"              {r.get('run_id',''):<18} {r.get('task_id','')}")


def _print_wrapped_kv(label, value, *, indent="      ", width=118):
    value = str(value or "(none)").strip() or "(none)"
    prefix = f"{indent}{label:<12}: "
    available = max(40, width - len(prefix))
    lines = textwrap.wrap(value, width=available, break_long_words=False, break_on_hyphens=False) or ["(none)"]
    print(prefix + lines[0])
    continuation = " " * len(prefix)
    for line in lines[1:]:
        print(continuation + line)


def print_runs(rows, n=20):
    print("\n=== recent runs ===")
    for r in rows[-n:][::-1]:
        meta = r.get("run_meta") or {}
        parts = token_parts(r)
        sid = ",".join(meta.get("pi_session_ids", [])[:1])
        print(f"{status(r):4s}  {r.get('run_id',''):<18} {r.get('task_id',''):<36} time={fmt_seconds(elapsed(r)):<6} tokens={parts['total']:<8} session={sid}")
        if detail_level >= 2:
            _print_wrapped_kv("model", _short_model(meta))
        if detail_level >= 3:
            catalog_path = str(meta.get("catalog_path", "") or "")
            config_root = str(Path(catalog_path).parent if catalog_path else "").strip() or "(none)"
            catalog_name = Path(catalog_path).name if catalog_path else "(none)"
            enabled_roles = meta.get("enabled_roles_summary") or ",".join(meta.get("enabled_roles") or []) or "(none)"
            notes = str(meta.get("notes", "") or "").strip()
            _print_wrapped_kv("run config", f"orchestra={_orchestra_activity_label(r)}; orch_on={_orchestra_label(meta)}; args={render_command_args(meta)}")
            _print_wrapped_kv("catalog", f"{config_root}/{catalog_name}" if catalog_path else "(none)")
            _print_wrapped_kv("roles", enabled_roles)
            _print_wrapped_kv("extensions", render_extensions(meta))
            _print_wrapped_kv("plugins", ",".join(_plugin_values(meta)) or "none")
            orch_version = render_orchestra_version(meta)
            if orch_version:
                _print_wrapped_kv("orchestra ver", orch_version)
            _print_wrapped_kv("skills", meta.get("aux_skills_summary", "") or "none")
            role_models = render_role_models_compact(meta)
            if role_models:
                _print_wrapped_kv("role models", role_models)
            if notes:
                _print_wrapped_kv("notes", notes)


def print_tasks(rows):
    print("\n=== per-test breakdown ===")
    suites = defaultdict(lambda: defaultdict(list))
    for r in rows:
        suites[suite_name(r)][r.get("task_id", "")].append(r)
    for suite in sorted(suites):
        print(f"\n[{suite}]")
        for task_id in sorted(suites[suite]):
            rs = suites[suite][task_id]
            print(f"- {task_id}")
            print_section_metrics(rs, indent="    ")


def _print_token_metrics(rows, prefix=""):
    """Print aggregate token metrics for a set of rows."""
    totals = [token_total(r) for r in rows if token_total(r)]
    if not totals:
        print(f"{prefix}no token data captured")
        return
    print(f"{prefix}runs_with_tokens: {len(totals)}/{len(rows)}")
    print(f"{prefix}total_tokens    : {sum(totals):,}")
    print(f"{prefix}avg_tokens      : {int(statistics.mean(totals)):,}")
    print(f"{prefix}median_tokens   : {int(statistics.median(totals)):,}")

    # Reasoning tokens breakdown
    reason_vals = [token_parts(r)["reasoning"] for r in rows if token_parts(r).get("reasoning")]
    if reason_vals:
        print(f"{prefix}avg_reasoning   : {int(statistics.mean(reason_vals)):,}")

    # Cache tokens breakdown
    cache_read = [token_parts(r)["cached_read"] for r in rows if token_parts(r).get("cached_read")]
    cache_write = [token_parts(r)["cache_write"] for r in rows if token_parts(r).get("cache_write")]
    if cache_read:
        print(f"{prefix}avg_cache_read  : {int(statistics.mean(cache_read)):,}")
    if cache_write:
        print(f"{prefix}avg_cache_write : {int(statistics.mean(cache_write)):,}")

    # Main context metrics
    context_vals = [main_context_input(r) for r in rows if main_context_input(r)]
    if context_vals:
        print(f"{prefix}avg_main_ctx_final: {int(statistics.mean(context_vals)):,}")
        max_ctx_vals = [max(main_context_input(r), main_context_max_input(r)) for r in rows
                        if main_context_input(r) or main_context_max_input(r)]
        if max_ctx_vals:
            print(f"{prefix}avg_main_ctx_max  : {int(statistics.mean(max_ctx_vals)):,}")

    # Main API call count and compaction
    api_calls = [main_api_call_count(r) for r in rows if main_api_call_count(r)]
    if api_calls:
        print(f"{prefix}avg_api_calls   : {int(statistics.mean(api_calls)):,}")
    compacations = [compaction_count(r) for r in rows if compaction_count(r)]
    if compacations:
        print(f"{prefix}total_compactions: {sum(compacations):,}")

    # Classified token breakdown (main vs roles)
    has_classified = any(has_classified_tokens(r) for r in rows)
    if has_classified:
        exp_totals = [exp_main_total(r) for r in rows if exp_main_total(r)]
        role_totals = [cheap_role_total(r) for r in rows if cheap_role_total(r)]

        print(f"\n{prefix}--- classified tokens ---")
        if exp_totals:
            print(f"{prefix}avg_main_tokens   : {int(statistics.mean(exp_totals)):,}")
        if role_totals:
            print(f"{prefix}avg_role_tokens   : {int(statistics.mean(role_totals)):,}")


def _print_by_task(rows, prefix=""):
    """Print per-task token breakdown."""
    by = defaultdict(list)
    for r in rows:
        if token_total(r):
            by[r.get("task_id", "")].append(token_total(r))
    if not by:
        return
    print(f"\n{prefix}by task:")
    has_classified = any(has_classified_tokens(r) for r in rows)
    header_fmt = f"{{:<38}} {{:6}}"
    row_fmt = f"{{:<38}} {{:5d}} total={{:<10,}} avg={{:,}}"

    if has_classified:
        print(f"{prefix}{header_fmt.format('task', 'runs')}{'':>30s}  main     role")
        for task_id in sorted(by):
            vals = by[task_id]
            # Find classified data for this task
            exp_vals = [exp_main_total(r) for r in rows if r.get("task_id") == task_id and exp_main_total(r)]
            role_vals = [cheap_role_total(r) for r in rows if r.get("task_id") == task_id and cheap_role_total(r)]
            main_text = f"{int(statistics.mean(exp_vals)):,}" if exp_vals else "-"
            role_text = f"{int(statistics.mean(role_vals)):,}" if role_vals else "-"
            avg_val = int(statistics.mean(vals))
            print(f"{prefix}{task_id:<38} {len(vals):<5d} total={sum(vals):<10,} avg={avg_val:<20,} main={main_text}  role={role_text}")
    else:
        for task_id in sorted(by):
            vals = by[task_id]
            print(f"{prefix}{row_fmt.format(task_id, len(vals), sum(vals), int(statistics.mean(vals)))}")


def print_tokens(rows):
    print("\n=== token usage ===")
    _print_token_metrics(rows)
    _print_by_task(rows)


def print_suites(rows):
    print("\n=== per-suite breakdown ===")
    by = defaultdict(list)
    for r in rows:
        by[suite_name(r)].append(r)
    for suite in sorted(by):
        print(f"\n[{suite}]")
        print_section_metrics(by[suite], indent="  ")


def print_timing(rows):
    print("\n=== elapsed time ===")
    vals = [elapsed(r) for r in rows if elapsed(r)]
    if not vals:
        print("no elapsed timing captured")
        return
    print(f"runs_with_time: {len(vals)}/{len(rows)}")
    print(f"total_elapsed : {fmt_seconds(sum(vals))}")
    print(f"avg_elapsed   : {fmt_seconds(statistics.mean(vals))}")
    print(f"median_elapsed: {fmt_seconds(statistics.median(vals))}")
    print("\nby role:")
    by_role = defaultdict(list)
    for r in rows:
        role = ((r.get("task_meta") or {}).get("family") or (r.get("run_meta") or {}).get("role") or "unknown")
        if elapsed(r):
            by_role[str(role)].append(elapsed(r))
    for role in sorted(by_role):
        vals = by_role[role]
        print(f"{role:<14} runs={len(vals):<3} total={fmt_seconds(sum(vals)):<8} avg={fmt_seconds(statistics.mean(vals))}")


def print_timeline(rows, n=20):
    print("\n=== timeline ===")
    for r in rows[-n:]:
        parts = token_parts(r)
        line = f"{r.get('run_id',''):<18} {status(r):4s} {r.get('task_id',''):<36} time={fmt_seconds(elapsed(r)):<6} total={parts['total']:<8} in={parts['input']:<8} out={parts['output']:<6} reason={parts['reasoning']}"
        # Append cache info when available
        if parts.get("cached_read") or parts.get("cache_write"):
            line += f" cache_r={parts['cached_read']}  cache_w={parts['cache_write']}"
        print(line)


def print_notes(rows):
    print("\n=== notes ===")
    by = defaultdict(list)
    for r in rows:
        note = str(((r.get("run_meta") or {}).get("notes", "")) or "").strip() or "(empty)"
        by[note].append(r)
    for note in sorted(by):
        rs = by[note]
        passed = sum(1 for r in rs if r.get("score") == "pass")
        print(f"runs={len(rs):<3} pass={passed}/{len(rs):<3} notes={note}")


def _has_any_selection_filter():
    return any([
        bool(task_filter),
        bool(suite_filter),
        bool(notes_filter),
        bool(model_filter),
        bool(plugins_filter),
        bool(skills_filter),
        bool(orchestra_filter),
        bool(no_orchestra_filter),
    ])


def _print_active_filters():
    if task_filter:
        print(f"task filter : {task_filter}")
    if suite_filter:
        print(f"suite filter: {suite_filter}")
    if notes_filter:
        print(f"notes filter: {notes_filter}")
    if model_filter:
        print(f"model filter: {model_filter}")
    if plugins_filter:
        print(f"plugins     : {plugins_filter}")
    if skills_filter:
        print(f"skills      : {skills_filter}")
    if orchestra_filter:
        print("orchestra   : enabled")
    if no_orchestra_filter:
        print("orchestra   : disabled")


def delete_filtered_results(rows):
    print("\n=== delete results ===")
    if not _has_any_selection_filter():
        print("[bench] refusing to delete without at least one filter", file=sys.stderr)
        raise SystemExit(2)
    if not rows:
        print("no graded result directories match the active filters")
        return

    _print_active_filters()
    print(f"matches     : {len(rows)} graded result director{'y' if len(rows) == 1 else 'ies'}")
    if not yes_delete:
        print("mode        : dry-run (add --yes to delete)")
    else:
        print("mode        : delete")

    for r in rows:
        rel_dir = str(r.get("_dir", ""))
        target = (root / rel_dir).resolve()
        try:
            target.relative_to(results_dir.resolve())
        except ValueError:
            print(f"SKIP unsafe path: {rel_dir}", file=sys.stderr)
            continue
        if target == results_dir.resolve() or not target.is_dir():
            print(f"SKIP missing/invalid: {rel_dir}", file=sys.stderr)
            continue
        print(f"{'DELETE' if yes_delete else 'WOULD DELETE'} {rel_dir}  notes={((r.get('run_meta') or {}).get('notes', '') or '')}")
        if yes_delete:
            shutil.rmtree(target)


def _safe_result_dir(rel_dir):
    target = (root / str(rel_dir or "")).resolve()
    try:
        target.relative_to(results_dir.resolve())
    except ValueError:
        return None
    if target == results_dir.resolve() or not target.is_dir():
        return None
    return target


def _orchestra_label(meta):
    return "off" if meta.get("orchestra") is False else "on" if meta.get("orchestra") is True else "unknown"


def _short_model(meta):
    text = _model_text(meta)
    if not text:
        return "(none)"
    first = text.split("|")[0].strip()
    return first.replace("lmstudio/", "")


def _config_record(rows):
    sample = rows[0]
    meta = sample.get("run_meta") or {}
    return {
        "model": _short_model(meta),
        "orchestra": _orchestra_activity_label(sample),
        "plugins": ",".join(_plugin_values(meta)) or "none",
        "skills": ",".join(_skill_values(meta)) or "none",
        "role_models": str(meta.get("role_models_summary", "") or ""),
    }


def _config_key(r):
    meta = r.get("run_meta") or {}
    return (
        _short_model(meta),
        _orchestra_activity_label(r),
        tuple(_plugin_values(meta)),
        tuple(_skill_values(meta)),
        str(meta.get("role_models_summary", "") or ""),
    )


def _config_groups(rows):
    grouped = defaultdict(list)
    for r in rows:
        grouped[_config_key(r)].append(r)
    ordered = sorted(grouped.items(), key=lambda kv: (-len(kv[1]), str(kv[0])))
    return [(f"C{i:02d}", key, rs) for i, (key, rs) in enumerate(ordered, 1)]


def _selected_config_ids():
    return {part.strip().upper() for part in configs_filter.replace(",", " ").split() if part.strip()}


def print_configs(rows):
    print("\n=== configs ===")
    groups = _config_groups(rows)
    if not groups:
        print("no matching graded runs")
        return
    print(f"{'ID':<4} {'runs':<5} {'pass':<7} {'model':<42} {'orch':<7} {'plugins':<34} {'skills'}")
    for cid, _key, rs in groups:
        rec = _config_record(rs)
        passed = sum(1 for r in rs if r.get("score") == "pass")
        print(f"{cid:<4} {len(rs):<5} {passed}/{len(rs):<5} {rec['model'][:42]:<42} {rec['orchestra']:<7} {rec['plugins'][:34]:<34} {rec['skills']}")


def _group_value(r, field):
    field = str(field or "").strip().lower()
    meta = r.get("run_meta") or {}
    if field == "model":
        return _short_model(meta)
    if field in {"orchestra", "orch"}:
        return f"orch:{_orchestra_activity_label(r)}"
    if field in {"orch_on", "orchestra_on"}:
        return f"orch_on:{_orchestra_label(meta)}"
    if field in {"plugins", "plugin"}:
        return "plugins:" + (",".join(_plugin_values(meta)) or "none")
    if field in {"skills", "skill"}:
        return "skills:" + (",".join(_skill_values(meta)) or "none")
    if field == "suite":
        return suite_name(r)
    if field in {"task", "task_id"}:
        return str(r.get("task_id", ""))
    if field == "notes":
        return str(meta.get("notes", "") or "") or "none"
    return f"{field}:?"


def _compare_groups(rows):
    selected_ids = _selected_config_ids()
    if selected_ids:
        allowed_rows = []
        for cid, _key, rs in _config_groups(rows):
            if cid.upper() in selected_ids:
                allowed_rows.extend(rs)
        rows = allowed_rows
    fields = [f.strip() for f in group_by_raw.replace(",", " ").split() if f.strip()] or ["model", "orchestra", "plugins", "skills"]
    grouped = defaultdict(list)
    for r in rows:
        grouped[" | ".join(_group_value(r, f) for f in fields)].append(r)
    return sorted(grouped.items(), key=lambda kv: (-len(kv[1]), kv[0]))


def _avg_or_none(values):
    return statistics.mean(values) if values else None


def print_compare(rows):
    print("\n=== compare ===")
    if configs_filter:
        print(f"configs : {configs_filter}")
    print(f"group by: {group_by_raw or 'model,orchestra,plugins,skills'}")
    groups = _compare_groups(rows)
    if not groups:
        print("no matching graded runs")
        return
    print(f"{'group':<72} {'runs':<5} {'pass':<7} {'score':<8} {'tokens':<11} {'elapsed'}")
    for label, rs in groups:
        passed = sum(1 for r in rs if r.get("score") == "pass")
        scores = numeric_scores(rs)
        toks = [token_total(r) for r in rs if token_total(r)]
        times = [elapsed(r) for r in rs if elapsed(r)]
        score_text = f"{statistics.mean(scores):.4f}" if scores else "-"
        tok_text = f"{int(statistics.mean(toks)):,}" if toks else "-"
        time_text = fmt_seconds(statistics.mean(times)) if times else "-"
        print(f"{label[:72]:<72} {len(rs):<5} {passed}/{len(rs):<5} {score_text:<8} {tok_text:<11} {time_text}")
    if per_task:
        print("\nper task:")
        by_task = defaultdict(list)
        for label, rs in groups:
            for r in rs:
                by_task[str(r.get("task_id", ""))].append((label, r))
        for task_id in sorted(by_task):
            print(f"\n{task_id}")
            for label, r in sorted(by_task[task_id], key=lambda item: item[0]):
                score_num = r.get("score_numeric")
                score_text = f"{score_num:.4f}" if isinstance(score_num, (int, float)) else str(r.get("score", ""))
                print(f"  {label[:58]:<58} {status(r):<4} score={score_text:<8} tokens={token_total(r):<9} time={fmt_seconds(elapsed(r))}")


def set_notes_for_filtered_results(rows):
    print("\n=== set result notes ===")
    if not _has_any_selection_filter():
        print("[bench] refusing to rewrite notes without at least one filter", file=sys.stderr)
        raise SystemExit(2)
    if new_notes == "":
        print("[bench] refusing to rewrite notes without --set-notes <text>", file=sys.stderr)
        raise SystemExit(2)
    if not rows:
        print("no graded result directories match the active filters")
        return

    _print_active_filters()
    print(f"new notes   : {new_notes}")
    print(f"matches     : {len(rows)} graded result director{'y' if len(rows) == 1 else 'ies'}")
    print(f"mode        : {'apply' if yes_delete else 'dry-run (add --yes to rewrite)'}")

    for r in rows:
        rel_dir = str(r.get("_dir", ""))
        target = _safe_result_dir(rel_dir)
        old_notes = str(((r.get("run_meta") or {}).get("notes", "")) or "")
        if target is None:
            print(f"SKIP unsafe/missing path: {rel_dir}", file=sys.stderr)
            continue
        print(f"{'UPDATE' if yes_delete else 'WOULD UPDATE'} {rel_dir}  notes={old_notes} -> {new_notes}")
        if not yes_delete:
            continue

        result_path = target / "result.json"
        data = json.loads(result_path.read_text())
        run_meta = data.get("run_meta")
        if not isinstance(run_meta, dict):
            run_meta = {}
            data["run_meta"] = run_meta
        run_meta["notes"] = new_notes
        result_path.write_text(json.dumps(data, indent=2) + "\n")

        bench_run_path = target / ".bench_run.json"
        if bench_run_path.is_file():
            try:
                bench_data = json.loads(bench_run_path.read_text())
            except Exception:
                bench_data = None
            if isinstance(bench_data, dict):
                bench_data["notes"] = new_notes
                bench_run_path.write_text(json.dumps(bench_data, indent=2) + "\n")


def _clip_text(text, max_chars=600):
    text = str(text or "").replace("\r", "")
    return text if len(text) <= max_chars else text[:max_chars] + "…"


def _content_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if not isinstance(item, dict):
                continue
            typ = item.get("type")
            if typ == "text":
                parts.append(str(item.get("text", "")))
            elif typ == "toolCall":
                parts.append(f"[toolCall {item.get('name','')}] {item.get('arguments','')}")
            elif typ == "toolResult":
                parts.append(f"[toolResult {item.get('toolName','')}] {item.get('content','')}")
            elif typ == "thinking":
                text = str(item.get("thinking", "") or "").strip()
                if text:
                    parts.append(f"[thinking] {text}")
        return "\n".join(part for part in parts if part)
    return str(content or "")


def _print_pi_session_trace(run_dir, max_events=0):
    session_dir = run_dir / "artifacts" / "pi-sessions"
    files = sorted(session_dir.glob("*.jsonl")) if session_dir.is_dir() else []
    if not files:
        print("\npi session trace: none captured")
        return False
    print("\npi session trace:")
    for path in files:
        events = []
        for line in path.read_text(errors="replace").splitlines():
            try:
                event = json.loads(line)
            except Exception:
                events.append(line)
                continue
            typ = event.get("type", "")
            msg = event.get("message") if isinstance(event.get("message"), dict) else {}
            if typ == "message" and msg:
                role = msg.get("role", "")
                content = _content_text(msg.get("content")).strip()
                if content:
                    events.append(f"{role}: {content}")
            elif typ in {"session", "toolCall", "toolResult", "compaction"}:
                events.append(json.dumps(event, ensure_ascii=False))
        print(f"\n-- {path.name} --")
        if not events:
            print("  (no printable events)")
            continue
        selected = events if max_events <= 0 else events[-max_events:]
        if max_events > 0 and len(events) > len(selected):
            print(f"  ... ({len(events) - len(selected)} earlier events omitted; use --limit 0 for full trace)")
        for event in selected:
            for line in event.splitlines():
                print(f"  {line}")
    return True


def _debug_text_looks_complete(text):
    stripped = str(text or "").strip().lower()
    if not stripped:
        return False
    if stripped.startswith("error:") or "requires 'skills'" in stripped or "unknown option" in stripped:
        return False
    return True


def _print_orchestra_debug_trace(run_dir):
    debug_dir = run_dir / "artifacts" / "orchestra-debug" / "debug"
    files = sorted(debug_dir.glob("*.md")) if debug_dir.is_dir() else []
    if not files:
        print("\norchestra debug trace: none captured")
        return False
    print("\norchestra debug trace:")
    complete = False
    for path in files:
        print(f"\n-- {path.relative_to(run_dir)} --")
        text = path.read_text(errors="replace")
        print(text, end="" if text.endswith("\n") else "\n")
        complete = complete or _debug_text_looks_complete(text)
    return complete


def print_debug_detail(rows, q):
    r = find_run(rows, q)
    if not r:
        print(f"[bench] run not found or ambiguous: {q}", file=sys.stderr)
        raise SystemExit(1)
    print_run_detail(rows, q)
    run_dir = (root / str(r.get("_dir", ""))).resolve()
    try:
        run_dir.relative_to(results_dir.resolve())
    except ValueError:
        print("\ndebug trace: unsafe result path")
        return
    orchestra_complete = _print_orchestra_debug_trace(run_dir)
    if orchestra_complete:
        print("\npi session trace: not printed separately; included in orchestra debug trace")
    else:
        print("\n[bench] orchestra debug trace is missing or incomplete; showing raw Pi session fallback")
        _print_pi_session_trace(run_dir, limit)


def print_run_detail(rows, q):
    r = find_run(rows, q)
    if not r:
        print(f"[bench] run not found or ambiguous: {q}", file=sys.stderr)
        raise SystemExit(1)
    print("=== run detail ===")
    print(f"run_id       : {r.get('run_id','')}")
    print(f"task_id      : {r.get('task_id','')}")
    score_value = str(r.get('score',''))
    score_display = color_pass_fail(score_value, score_value == 'pass') if score_value in {'pass', 'fail'} else score_value
    print(f"score        : {score_display}")
    score_numeric = r.get("score_numeric")
    if isinstance(score_numeric, (int, float)):
        print(f"score_numeric: {score_numeric:.4f}")
    print(f"rubric       : {format_rubric_summary(r.get('rubric'))}")
    print(f"result       : {r.get('_path','')}")
    print(f"artifacts    : {r.get('_dir','')}/artifacts/")
    meta = r.get("run_meta") or {}
    print(f"role         : {meta.get('role','')}")
    print(f"args         : {render_command_args(meta)}")
    if meta.get("target_role"):
        print(f"target       : {meta.get('target_role','')}")
    sessions = meta.get("pi_session_ids") or []
    print(f"sessions     : {', '.join(sessions) if sessions else 'none captured'}")
    print(f"extensions   : {render_extensions(meta)}")
    orch_version = render_orchestra_version(meta)
    if orch_version:
        print(f"orchestra ver: {orch_version}")
    print(f"skills       : {meta.get('aux_skills_summary','')}")
    catalog_path = str(meta.get('catalog_path','') or '')
    config_root = str(Path(catalog_path).parent if catalog_path else '')
    print(f"config       : {config_root}")
    parts = token_parts(r)
    print(f"elapsed      : {fmt_seconds(elapsed(r))}")

    # Legacy flat token line (always shown for backward compat)
    print(f"tokens       : total={parts['total']:,} input={parts['input']:,} output={parts['output']:,} reasoning={parts['reasoning']:,}")

    # Classified tokens and context info when available
    t = r.get("tokens") or {}
    exp_main = _get_exp_main_tokens(r)
    cheap_role = _get_cheap_role_tokens(r)
    ctx_final = main_context_input(r)
    ctx_max = main_context_max_input(r)
    api_calls = main_api_call_count(r)
    compactions = compaction_count(r)

    if has_classified_tokens(r):
        print("\ntokens (classified):")
        exp_total_val = exp_main.get("total_tokens")
        role_total_val = cheap_role.get("total_tokens")
        all_total = token_total(r)

        if isinstance(exp_total_val, (int, float)) and exp_total_val > 0:
            print(f"  main_session   : {exp_total_val:,} tokens")
            # Show main session breakdown
            for label, key in [("input", "input_tokens"), ("output", "output_tokens"),
                               ("reasoning", "reasoning_tokens"),
                               ("cached_read", "cached_input_read_tokens"),
                               ("cache_write", "cache_write_tokens")]:
                v = exp_main.get(key)
                if isinstance(v, (int, float)) and v > 0:
                    print(f"    {label:<14}: {v:,}")

        if isinstance(role_total_val, (int, float)) and role_total_val > 0:
            print(f"  role_sessions  : {role_total_val:,} tokens")
            for label, key in [("input", "input_tokens"), ("output", "output_tokens"),
                               ("reasoning", "reasoning_tokens")]:
                v = cheap_role.get(key)
                if isinstance(v, (int, float)) and v > 0:
                    print(f"    {label:<14}: {v:,}")

        # Show all vs main + roles comparison
        total_all = _safe_int(t.get("total_tokens"))
        if total_all and (isinstance(exp_total_val, (int, float)) or isinstance(role_total_val, (int, float))):
            print(f"  all_sessions   : {total_all:,} tokens")

    # Main session context info when available
    has_context = ctx_final > 0 or ctx_max > 0 or api_calls > 0 or compactions > 0
    if has_context:
        print("\nmain_session context:")
        if ctx_final > 0:
            print(f"  final_context   : {ctx_final:,} tokens")
        if ctx_max > 0 and ctx_max != ctx_final:
            print(f"  max_context     : {ctx_max:,} tokens")
        elif ctx_max == ctx_final and ctx_final > 0:
            # Only one value, show it once
            pass
        if api_calls > 0:
            print(f"  api_calls       : {api_calls}")
        if compactions > 0:
            print(f"  compactions     : {compactions}")

    active_worker_tokens = main_active_worker_tokens(r)
    active_worker_api_calls = main_active_worker_api_calls(r)
    if active_worker_tokens > 0 or active_worker_api_calls > 0:
        print("\nmain_session worker overlap:")
        if active_worker_tokens > 0:
            print(f"  main_active_worker_tokens: {active_worker_tokens:,}")
        if active_worker_api_calls > 0:
            print(f"  main_active_worker_api_calls: {active_worker_api_calls}")

    efficiency_lines = format_efficiency_summary(TaskResult.from_json(root / r.get('_path', '')), results_dir)
    if efficiency_lines:
        print("\nefficiency:")
        for line in efficiency_lines:
            print(f"  {line}")

    checks = r.get("checks") or {}
    print("\nchecks:")
    if checks:
        for k, v in checks.items():
            value = color_bool_value(v) if isinstance(v, bool) else v
            print(f"  {k}: {value}")
    else:
        print("  none")

    orch_checks = r.get("orchestration_checks") or {}
    special_efficiency_keys = {
        "parent_tool_calls_while_workers_active",
        "test_command_ownership_by_role",
        "duplicate_normalized_test_command_counts",
        "verifier_repeated_builder_tests",
        "orchestrator_repeated_worker_tests",
    }
    if orch_checks:
        special_keys = [key for key in special_efficiency_keys if key in orch_checks]
        if special_keys:
            print("\norchestration efficiency:")
            parent_tools = orch_checks.get("parent_tool_calls_while_workers_active")
            if isinstance(parent_tools, dict):
                total = parent_tools.get("total")
                by_category = _format_count_mapping(parent_tools.get("by_category"))
                if isinstance(total, (int, float)):
                    line = f"  parent_tool_calls_while_workers_active: total={int(total):,}"
                    if by_category:
                        line += f" by_category={by_category}"
                    print(line)
            ownership = orch_checks.get("test_command_ownership_by_role")
            if isinstance(ownership, dict):
                text = _format_count_mapping(ownership)
                if text:
                    print(f"  test_command_ownership_by_role: {text}")
            duplicates = orch_checks.get("duplicate_normalized_test_command_counts")
            if isinstance(duplicates, dict):
                text = _format_count_mapping(duplicates)
                if text:
                    print(f"  duplicate_normalized_test_command_counts: {text}")
            for key in ("verifier_repeated_builder_tests", "orchestrator_repeated_worker_tests"):
                value = orch_checks.get(key)
                if isinstance(value, (int, float)):
                    print(f"  {key}: {int(value)}")
        remaining_orch = {k: v for k, v in orch_checks.items() if k not in special_efficiency_keys}
        if remaining_orch:
            print("\norchestration:")
            for key in sorted(remaining_orch):
                value = remaining_orch[key]
                if isinstance(value, bool):
                    text = "True" if value else "False"
                    value = color_for_behavior_rate(key, text, 1 if value else 0, 1)
                elif isinstance(value, (int, float)):
                    value = color_for_behavior_count(key, str(value), int(value))
                print(f"  {key}: {value}")
    warnings = orchestration_warnings(orch_checks)
    if warnings:
        print("\norchestration warnings:")
        for warning in warnings:
            print(f"  - {colorize(warning, 'red')}")

    orch = meta.get("orchestra_artifacts") or {}
    if orch:
        print("\norchestra artifacts:")
        for k, v in orch.items():
            print(f"  {k}: {v}")

rows = load_results()
if view == "dashboard":
    print_overview(rows); print_suites(rows); print_tasks(rows)
elif view == "runs":
    print_runs(rows, limit)
elif view == "run":
    print_run_detail(rows, run_query)
elif view == "debug":
    print_debug_detail(rows, run_query)
elif view == "tasks":
    print_tasks(rows)
elif view == "timeline":
    print_timeline(rows, limit)
elif view == "tokens":
    print_tokens(rows)
elif view == "timing":
    print_timing(rows)
elif view == "notes":
    print_notes(rows)
elif view == "configs":
    print_configs(rows)
elif view == "compare":
    print_compare(rows)
elif view == "delete":
    delete_filtered_results(rows)
elif view == "set-notes":
    set_notes_for_filtered_results(rows)
else:
    print(f"unknown view: {view}", file=sys.stderr)
    raise SystemExit(1)
