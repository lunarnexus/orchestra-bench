#!/usr/bin/env bash
# 05-results — Historical benchmark reporting, plus guarded result deletion.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SCRIPT_DIR/.."

usage() {
  cat <<EOF
Usage: $(basename "$0") [view] [options]

Views:
  dashboard        Default: overview, per-suite breakdown, per-test breakdown
  runs             List historical graded runs
  run <id|dir>     Show one run in detail
  tasks            Task pass/fail breakdown
  timeline         Results over time
  tokens           Token usage across runs/tasks
  timing           Elapsed time across tasks/roles
  notes            List distinct run notes (sort/uniq style)
  delete           Delete graded result directories matching filters (requires --notes; dry-run unless --yes)

Options:
  --task <id>         Filter to one task
  --suite <name>      Filter to one suite/batch/family
  --notes <text>      Filter runs by notes substring match
  --detail <1|2|3>    Dashboard detail level (default: 3)
  --rubric [names]    Show only rubric breakdowns; optional comma-separated names
  --checks [names]    Show only check breakdowns; optional comma-separated names
  --behaviors [names] Show only behavior breakdowns; optional comma-separated names
  --limit <n>         Limit rows for runs/timeline (default: 20)
  --yes               Actually delete matches for the delete view (default is dry-run)

Examples:
  scripts/05-results
  scripts/05-results runs --limit 50
  scripts/05-results run 20260810T004753-smoke-dependent-setup-chain
  scripts/05-results run 20260810T004753
  scripts/05-results tasks
  scripts/05-results timeline --task smoke-dependent-setup-chain
  scripts/05-results tokens
  scripts/05-results timing
  scripts/05-results delete --notes "Batch1"       # dry-run preview
  scripts/05-results delete --notes "Batch1" --yes # delete matched run dirs
EOF
}

view="dashboard"
if [ $# -gt 0 ]; then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    dashboard|runs|run|tasks|timeline|tokens|timing|notes|delete) view="$1"; shift ;;
  esac
fi

run_query=""
task_filter=""
suite_filter=""
notes_filter=""
detail_level="3"
rubric_filter=""
checks_filter=""
behaviors_filter=""
limit="20"
yes_delete="false"

if [ "$view" = "run" ]; then
  run_query="${1:-}"
  [ -n "$run_query" ] || { usage; exit 1; }
  shift || true
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --task) task_filter="$2"; shift 2 ;;
    --suite) suite_filter="$2"; shift 2 ;;
    --notes) notes_filter="$2"; shift 2 ;;
    --detail) detail_level="$2"; shift 2 ;;
    --rubric)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then rubric_filter="$2"; shift 2
      else rubric_filter="__all__"; shift
      fi ;;
    --checks)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then checks_filter="$2"; shift 2
      else checks_filter="__all__"; shift
      fi ;;
    --behaviors)
      if [ $# -gt 1 ] && [[ "$2" != --* ]]; then behaviors_filter="$2"; shift 2
      else behaviors_filter="__all__"; shift
      fi ;;
    --limit) limit="$2"; shift 2 ;;
    --yes) yes_delete="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[bench] unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

python3 - "$ROOT" "$view" "$run_query" "$task_filter" "$suite_filter" "$notes_filter" "$detail_level" "$rubric_filter" "$checks_filter" "$behaviors_filter" "$limit" "$yes_delete" <<'PY'
from __future__ import annotations

import json
import os
import shutil
import statistics
import sys
from collections import defaultdict
from pathlib import Path

ANSI = {
    "red": "\033[31m",
    "green": "\033[32m",
    "reset": "\033[0m",
}
COLOR_ENABLED = sys.stdout.isatty() and not bool(os.environ.get("NO_COLOR"))

root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))
from __init__ import TaskResult
from eval_harness import format_efficiency_summary, format_rubric_summary, orchestration_warnings

view = sys.argv[2]
run_query = sys.argv[3]
task_filter = sys.argv[4]
suite_filter = sys.argv[5].strip().lower()
notes_filter = sys.argv[6].strip().lower()
try:
    detail_level = int(sys.argv[7])
except Exception:
    detail_level = 3
if detail_level not in (1, 2, 3):
    detail_level = 3
rubric_filter = sys.argv[8].strip()
checks_filter = sys.argv[9].strip()
behaviors_filter = sys.argv[10].strip()
try:
    limit = int(sys.argv[11])
except Exception:
    limit = 20
yes_delete = sys.argv[12].strip().lower() == "true"

results_dir = root / "results"
tasks_dir = root / "tasks"

current_tasks = set()
for y in tasks_dir.glob("*/task.yaml"):
    task_id = y.parent.name
    for line in y.read_text().splitlines():
        s = line.strip()
        if s.startswith("task_id:"):
            task_id = s.split(":", 1)[1].strip().strip('"')
            break
    current_tasks.add(task_id)


def prepared_only_runs():
    out = []
    if not results_dir.is_dir():
        return out
    for p in sorted(results_dir.glob("*/.bench_run.json")):
        if not (p.parent / "result.json").exists():
            try:
                d = json.loads(p.read_text())
            except Exception:
                continue
            task_id = d.get("task_id", "")
            if current_tasks and task_id not in current_tasks:
                continue
            if task_filter and task_id != task_filter:
                continue
            suite = str(d.get("batch", d.get("family", "")) or "").strip().lower()
            if suite_filter and suite_filter != suite:
                continue
            notes = str(d.get("notes", "") or "")
            if notes_filter and notes_filter not in notes.lower():
                continue
            d["_dir"] = str(p.parent.relative_to(root))
            out.append(d)
    return out


def load_results():
    rows = []
    if not results_dir.is_dir():
        return rows
    for p in sorted(results_dir.glob("*/result.json")):
        try:
            d = json.loads(p.read_text())
        except Exception:
            continue
        task_id = d.get("task_id", "")
        if current_tasks and task_id not in current_tasks:
            continue
        if task_filter and task_id != task_filter:
            continue
        suite = suite_name(d).strip().lower()
        if suite_filter and suite_filter != suite:
            continue
        notes = str(((d.get("run_meta") or {}).get("notes", "")) or "")
        if notes_filter and notes_filter not in notes.lower():
            continue
        d["_dir"] = str(p.parent.relative_to(root))
        d["_path"] = str(p.relative_to(root))
        d["_mtime"] = p.stat().st_mtime
        rows.append(d)
    rows.sort(key=lambda r: (str(r.get("run_id", "")), str(r.get("task_id", ""))))
    return rows


def token_total(r):
    t = r.get("tokens") or {}
    for k in ("total", "total_tokens"):
        v = t.get(k)
        if isinstance(v, (int, float)):
            return int(v)
    return 0


def token_parts(r):
    t = r.get("tokens") or {}
    return {
        "input": int(t.get("input_tokens", t.get("prompt_tokens", 0)) or 0),
        "output": int(t.get("output_tokens", t.get("completion_tokens", 0)) or 0),
        "reasoning": int(t.get("reasoning_tokens", 0) or 0),
        "total": token_total(r),
    }


def elapsed(r):
    v = r.get("elapsed_seconds")
    return float(v) if isinstance(v, (int, float)) else 0.0


def fmt_seconds(value):
    if not value:
        return "-"
    if value < 60:
        return f"{value:.0f}s"
    return f"{value/60:.1f}m"


def colorize(text, color):
    if not COLOR_ENABLED:
        return text
    code = ANSI.get(color)
    if not code:
        return text
    return f"{code}{text}{ANSI['reset']}"


def color_pass_fail(text, passed):
    return colorize(text, "green" if passed else "red")


def color_for_rate(text, numerator, denominator):
    if denominator <= 0:
        return text
    if numerator == denominator:
        return colorize(text, "green")
    if numerator == 0:
        return colorize(text, "red")
    return text


def color_for_behavior_rate(name, text, numerator, denominator):
    if denominator <= 0:
        return text
    positive_when_true = {
        "target_role_dispatched",
        "worker_completed",
    }
    negative_when_true = {
        "premature_completion",
        "fallback_answer_after_dispatch",
        "worker_running_without_exit",
        "missing_expected_role",
        "no_orchestration",
        "process_penalty_applied",
    }
    name = str(name or "")
    if name in positive_when_true:
        return color_for_rate(text, numerator, denominator)
    if name in negative_when_true:
        if numerator == 0:
            return colorize(text, "green")
        if numerator == denominator:
            return colorize(text, "red")
        return text
    return text


def color_for_behavior_count(name, text, total):
    name = str(name or "")
    bad_when_nonzero = {
        "timeouts",
        "retries",
        "scope_blockers",
        "same_slice_redispatches",
    }
    if name in bad_when_nonzero:
        if total == 0:
            return colorize(text, "green")
        return colorize(text, "red")
    return text


def status(r):
    return color_pass_fail("PASS" if r.get("score") == "pass" else "FAIL", r.get("score") == "pass")


def _parse_name_filter(raw):
    raw = str(raw or "").strip()
    if not raw:
        return None
    if raw == "__all__":
        return []
    return [part.strip().lower() for part in raw.split(",") if part.strip()]


rubric_names = _parse_name_filter(rubric_filter)
check_names = _parse_name_filter(checks_filter)
behavior_names = _parse_name_filter(behaviors_filter)
section_only_mode = any(x is not None for x in (rubric_names, check_names, behavior_names))


def _name_selected(name, selected):
    if selected is None:
        return False
    if selected == []:
        return True
    lowered = str(name or "").strip().lower()
    return lowered in selected


def suite_name(r):
    task_meta = r.get("task_meta") or {}
    batch = str(task_meta.get("batch", "") or "").strip()
    family = str(task_meta.get("family", "") or "").strip()
    if batch:
        return batch
    if family and family != "default":
        return family
    return "unbatched"


def numeric_scores(rows):
    vals = []
    for r in rows:
        v = r.get("score_numeric")
        if isinstance(v, (int, float)):
            vals.append(float(v))
    return vals


def category_score_values(rows, name):
    vals = []
    for r in rows:
        cats = r.get("category_scores") or {}
        if not isinstance(cats, dict):
            continue
        v = cats.get(name)
        if isinstance(v, (int, float)):
            vals.append(float(v))
    return vals


def bool_check_rate(rows, key):
    vals = []
    for r in rows:
        checks = r.get("checks") or {}
        if isinstance(checks.get(key), bool):
            vals.append(bool(checks.get(key)))
    if not vals:
        return None
    return sum(1 for v in vals if v) / len(vals)


def aggregate_rubric(rows):
    by_cat = defaultdict(list)
    total_pairs = []
    for r in rows:
        rubric = r.get("rubric") or {}
        run_score = 0.0
        run_max = 0.0
        has_any = False
        for name, value in rubric.items():
            if not isinstance(value, dict):
                continue
            score = value.get("score")
            max_score = value.get("max")
            if isinstance(score, (int, float)) and isinstance(max_score, (int, float)):
                score_f = float(score)
                max_f = float(max_score)
                by_cat[str(name)].append((score_f, max_f))
                run_score += score_f
                run_max += max_f
                has_any = True
        if has_any:
            total_pairs.append((run_score, run_max))
    out = []
    for name in sorted(by_cat):
        vals = by_cat[name]
        avg_score = statistics.mean(v[0] for v in vals)
        avg_max = statistics.mean(v[1] for v in vals)
        pct = (avg_score / avg_max * 100.0) if avg_max else 0.0
        out.append((name, avg_score, avg_max, pct, len(vals)))
    return out, total_pairs


def aggregate_bool_checks(rows):
    keys = set()
    for r in rows:
        checks = r.get("checks") or {}
        for key, value in checks.items():
            if isinstance(value, bool):
                keys.add(str(key))
    out = []
    for key in sorted(keys):
        rate = bool_check_rate(rows, key)
        if rate is None:
            continue
        out.append((key, rate, sum(1 for r in rows if isinstance((r.get("checks") or {}).get(key), bool))))
    return out


def aggregate_orchestration(rows):
    metrics = {}
    numeric_keys = (
        "compaction_count",
        "dispatch_count",
        "timeouts",
        "retries",
        "scope_blockers",
        "same_slice_redispatches",
    )
    bool_keys = (
        "target_role_dispatched",
        "worker_completed",
        "worker_running_without_exit",
        "fallback_answer_after_dispatch",
        "premature_completion",
        "missing_expected_role",
        "no_orchestration",
        "process_penalty_applied",
    )
    for key in numeric_keys:
        vals = []
        for r in rows:
            checks = r.get("orchestration_checks") or {}
            v = checks.get(key, 0)
            if isinstance(v, (int, float)):
                vals.append(float(v))
            else:
                vals.append(0.0)
        if vals:
            metrics[key] = {
                "kind": "numeric",
                "total": sum(vals),
                "avg": statistics.mean(vals),
                "high": max(vals),
                "low": min(vals),
                "count": len(vals),
            }
    for key in bool_keys:
        vals = []
        for r in rows:
            checks = r.get("orchestration_checks") or {}
            v = checks.get(key)
            if isinstance(v, bool):
                vals.append(v)
        if vals:
            true_count = sum(1 for v in vals if v)
            metrics[key] = {
                "kind": "bool",
                "true": true_count,
                "false": len(vals) - true_count,
                "rate": true_count / len(vals),
                "count": len(vals),
            }
    return metrics


def print_metric_line(label, values, *, integer=False, formatter=None):
    if not values:
        print(f"{label:<12}: none captured yet")
        return
    total = sum(values)
    avg = statistics.mean(values)
    median = statistics.median(values)
    high = max(values)
    low = min(values)
    if formatter is None:
        if integer:
            formatter = lambda v: f"{int(v):,}"
        else:
            formatter = lambda v: str(v)
    print(
        f"{label:<12}: total={formatter(total)} avg={formatter(avg)} median={formatter(median)} high={formatter(high)} low={formatter(low)}"
    )


def print_score_breakdown(rows, indent="  "):
    if not section_only_mode and detail_level >= 2:
        scores = numeric_scores(rows)
        if scores:
            print(f"{indent}score_numeric: avg={statistics.mean(scores):.4f} median={statistics.median(scores):.4f} high={max(scores):.4f} low={min(scores):.4f} n={len(scores)}")

    rubric_items, rubric_totals = aggregate_rubric(rows)
    rubric = rubric_items if rubric_names is None else [item for item in rubric_items if _name_selected(item[0], rubric_names)]
    if rubric_names is not None and rubric:
        print(f"{indent}rubric:")
        for name, avg_score, avg_max, pct, count in rubric:
            print(f"{indent}  - {name}: {avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={count}")
    elif not section_only_mode and rubric and detail_level >= 3:
        print(f"{indent}rubric:")
        for name, avg_score, avg_max, pct, count in rubric:
            print(f"{indent}  - {name}: {avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={count}")
    elif not section_only_mode and rubric_totals and detail_level == 2:
        scores_only = [v[0] for v in rubric_totals]
        max_only = [v[1] for v in rubric_totals]
        avg_score = statistics.mean(scores_only)
        avg_max = statistics.mean(max_only)
        pct = (avg_score / avg_max * 100.0) if avg_max else 0.0
        print(f"{indent}rubric       : avg={avg_score:.4f}/{avg_max:.4f} ({pct:.0f}%) n={len(rubric_totals)}")

    category_blocks = []
    for name in ("intelligence", "speed", "efficiency", "process"):
        vals = category_score_values(rows, name)
        if vals:
            category_blocks.append((name, statistics.mean(vals), statistics.median(vals), max(vals), min(vals), len(vals)))
    if category_blocks and detail_level >= 2:
        print(f"{indent}categories:")
        for name, avg_v, med_v, high_v, low_v, count in category_blocks:
            print(f"{indent}  - {name}: avg={avg_v:.4f} median={med_v:.4f} high={high_v:.4f} low={low_v:.4f} n={count}")

    bool_checks = aggregate_bool_checks(rows) if check_names is None else [item for item in aggregate_bool_checks(rows) if _name_selected(item[0], check_names)]
    if check_names is not None and bool_checks:
        print(f"{indent}checks:")
        for key, rate, count in bool_checks:
            passed = int(round(rate * count))
            text = f"{rate*100:.0f}% pass ({passed}/{count})"
            print(f"{indent}  - {key}: {color_for_rate(text, passed, count)}")
    elif not section_only_mode and bool_checks and detail_level >= 3:
        print(f"{indent}checks:")
        for key, rate, count in bool_checks:
            passed = int(round(rate * count))
            text = f"{rate*100:.0f}% pass ({passed}/{count})"
            print(f"{indent}  - {key}: {color_for_rate(text, passed, count)}")
    elif not section_only_mode and bool_checks and detail_level == 2:
        avg_rate = statistics.mean(rate for _, rate, _ in bool_checks) * 100.0
        print(f"{indent}checks       : avg_pass_rate={avg_rate:.0f}% metrics={len(bool_checks)}")

    orchestration_all = aggregate_orchestration(rows)
    orchestration = orchestration_all if behavior_names is None else {k: v for k, v in orchestration_all.items() if _name_selected(k, behavior_names)}
    if behavior_names is not None and orchestration:
        print(f"{indent}behaviors:")
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                text = f"true={int(data['true'])} false={int(data['false'])} rate={data['rate']*100:.0f}%"
                print(f"{indent}  - {key}: {color_for_behavior_rate(key, text, int(data['true']), int(data['count']))}")
            else:
                text = f"total={int(data['total'])} avg={data['avg']:.2f} high={int(data['high'])} low={int(data['low'])}"
                print(f"{indent}  - {key}: {color_for_behavior_count(key, text, int(data['total']))}")
    elif not section_only_mode and orchestration and detail_level >= 3:
        print(f"{indent}behaviors:")
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                text = f"true={int(data['true'])} false={int(data['false'])} rate={data['rate']*100:.0f}%"
                print(f"{indent}  - {key}: {color_for_behavior_rate(key, text, int(data['true']), int(data['count']))}")
            else:
                text = f"total={int(data['total'])} avg={data['avg']:.2f} high={int(data['high'])} low={int(data['low'])}"
                print(f"{indent}  - {key}: {color_for_behavior_count(key, text, int(data['total']))}")
    elif not section_only_mode and orchestration and detail_level == 2:
        summary_parts = []
        for key in sorted(orchestration):
            data = orchestration[key]
            if data.get("kind") == "bool":
                summary_parts.append(f"{key}={int(data['true'])}/{int(data['count'])}")
            else:
                summary_parts.append(f"{key}={int(data['total'])}")
        print(f"{indent}behaviors    : {', '.join(summary_parts)}")


def print_section_metrics(rows, indent=""):
    passed = sum(1 for r in rows if r.get("score") == "pass")
    failed = len(rows) - passed
    print(f"{indent}runs        : {len(rows)}")
    if rows:
        print(f"{indent}pass rate   : {color_for_rate(f'{passed}/{len(rows)}', passed, len(rows))}")
    else:
        print(f"{indent}pass rate   : n/a")
    toks = [token_total(r) for r in rows if token_total(r)]
    print_metric_line(f"{indent}tokens", toks, integer=True)
    times = [elapsed(r) for r in rows if elapsed(r)]
    print_metric_line(f"{indent}elapsed", times, formatter=fmt_seconds)
    if detail_level >= 2 or section_only_mode:
        print_score_breakdown(rows, indent + "  ")


def find_run(rows, q):
    for r in rows:
        if q in {str(r.get("run_id", "")), f"{r.get('run_id')}-{r.get('task_id')}", r.get("_dir", "").split("/", 1)[-1]}:
            return r
    matches = [r for r in rows if q and (q in str(r.get("run_id", "")) or q in str(r.get("task_id", "")) or q in r.get("_dir", ""))]
    if len(matches) == 1:
        return matches[0]
    return None


def unique_meta_values(rows, key, *, default="(none)"):
    values = []
    seen = set()
    for r in rows:
        meta = r.get("run_meta") or {}
        value = meta.get(key)
        if isinstance(value, list):
            value_text = ",".join(str(v) for v in value) if value else default
        elif value is None or value == "":
            value_text = default
        else:
            value_text = str(value)
        if value_text not in seen:
            seen.add(value_text)
            values.append(value_text)
    return values


def render_command_args(meta):
    args = []
    if meta.get("auto") is True:
        args.append("--auto")
    if meta.get("orchestra") is False:
        args.append("--no-orchestra")
    return " ".join(args) if args else "(interactive/default)"


def render_extensions(meta):
    names = []
    seen = set()
    for key in ("pi_extensions", "pi_package_names"):
        raw = meta.get(key)
        if isinstance(raw, list):
            parts = [str(v).strip() for v in raw if str(v).strip()]
        else:
            parts = []
    
        for part in parts:
            if part not in seen:
                seen.add(part)
                names.append(part)

    for key in ("pi_extensions_summary", "pi_packages_summary"):
        raw = str(meta.get(key, "") or "")
        for part in [p.strip() for p in raw.split(",") if p.strip() and p.strip() != "none"]:
            if part not in seen:
                seen.add(part)
                names.append(part)

    return ",".join(names) if names else "(none)"


def unique_command_args(rows):
    values = []
    seen = set()
    for r in rows:
        text = render_command_args(r.get("run_meta") or {})
        if text not in seen:
            seen.add(text)
            values.append(text)
    return values


def print_overview(rows):
    pending = prepared_only_runs()
    passed = sum(1 for r in rows if r.get("score") == "pass")
    failed = len(rows) - passed
    print("=== orchestra-bench results dashboard ===")
    if task_filter:
        print(f"task filter : {task_filter}")
    if suite_filter:
        print(f"suite filter: {suite_filter}")
    if notes_filter:
        print(f"notes filter: {notes_filter}")
    print(f"detail level: {detail_level}")
    if rubric_names is not None:
        print(f"rubric view : {'all' if rubric_names == [] else ', '.join(rubric_names)}")
    if check_names is not None:
        print(f"checks view : {'all' if check_names == [] else ', '.join(check_names)}")
    if behavior_names is not None:
        print(f"behaviors   : {'all' if behavior_names == [] else ', '.join(behavior_names)}")
    print(f"graded runs : {len(rows)}")
    arg_vals = unique_command_args(rows)
    ext_vals = []
    seen_exts = set()
    for r in rows:
        ext_text = render_extensions(r.get("run_meta") or {})
        if ext_text not in seen_exts:
            seen_exts.add(ext_text)
            ext_vals.append(ext_text)
    skill_vals = unique_meta_values(rows, "aux_skills_summary")
    config_root_vals = []
    seen_config_roots = set()
    for r in rows:
        meta = r.get("run_meta") or {}
        catalog_path = str(meta.get("catalog_path", "") or "").strip()
        config_root = str(Path(catalog_path).parent if catalog_path else "").strip() or "(none)"
        if config_root not in seen_config_roots:
            seen_config_roots.add(config_root)
            config_root_vals.append(config_root)
    print(f"args        : {' | '.join(arg_vals)}")
    print(f"extensions  : {' | '.join(ext_vals)}")
    print(f"skills      : {' | '.join(skill_vals)}")
    print(f"config      : {' | '.join(config_root_vals)}")
    print(f"passed      : {colorize(str(passed), 'green') if passed else passed}")
    print(f"failed      : {colorize(str(failed), 'red') if failed else failed}")
    print(f"pass rate   : {color_for_rate(f'{passed}/{len(rows)}', passed, len(rows))}" if rows else "pass rate   : n/a")
    toks = [token_total(r) for r in rows if token_total(r)]
    print_metric_line("tokens", toks, integer=True)
    times = [elapsed(r) for r in rows if elapsed(r)]
    print_metric_line("elapsed", times, formatter=fmt_seconds)
    if pending:
        print(f"ungraded    : {len(pending)} prepared run(s); grade with scripts/03-collect-results <task-id>")
        for r in pending[-5:][::-1]:
            print(f"              {r.get('run_id',''):<18} {r.get('task_id','')}")


def print_runs(rows, n=20):
    print("\n=== recent runs ===")
    for r in rows[-n:][::-1]:
        parts = token_parts(r)
        sid = ",".join((r.get("run_meta") or {}).get("pi_session_ids", [])[:1])
        print(f"{status(r):4s}  {r.get('run_id',''):<18} {r.get('task_id',''):<36} time={fmt_seconds(elapsed(r)):<6} tokens={parts['total']:<8} session={sid}")


def print_tasks(rows):
    print("\n=== per-test breakdown ===")
    suites = defaultdict(lambda: defaultdict(list))
    for r in rows:
        suites[suite_name(r)][r.get("task_id", "")].append(r)
    for suite in sorted(suites):
        print(f"\n[{suite}]")
        for task_id in sorted(suites[suite]):
            rs = suites[suite][task_id]
            print(f"- {task_id}")
            print_section_metrics(rs, indent="    ")


def print_tokens(rows):
    print("\n=== token usage ===")
    totals = [token_total(r) for r in rows if token_total(r)]
    if not totals:
        print("no token data captured")
        return
    print(f"runs_with_tokens: {len(totals)}/{len(rows)}")
    print(f"total_tokens    : {sum(totals):,}")
    print(f"avg_tokens      : {int(statistics.mean(totals)):,}")
    print(f"median_tokens   : {int(statistics.median(totals)):,}")
    print("\nby task:")
    by = defaultdict(list)
    for r in rows:
        if token_total(r):
            by[r.get("task_id", "")].append(token_total(r))
    for task_id in sorted(by):
        vals = by[task_id]
        print(f"{task_id:<38} runs={len(vals):<3} total={sum(vals):<10,} avg={int(statistics.mean(vals)):,}")


def print_suites(rows):
    print("\n=== per-suite breakdown ===")
    by = defaultdict(list)
    for r in rows:
        by[suite_name(r)].append(r)
    for suite in sorted(by):
        print(f"\n[{suite}]")
        print_section_metrics(by[suite], indent="  ")


def print_timing(rows):
    print("\n=== elapsed time ===")
    vals = [elapsed(r) for r in rows if elapsed(r)]
    if not vals:
        print("no elapsed timing captured")
        return
    print(f"runs_with_time: {len(vals)}/{len(rows)}")
    print(f"total_elapsed : {fmt_seconds(sum(vals))}")
    print(f"avg_elapsed   : {fmt_seconds(statistics.mean(vals))}")
    print(f"median_elapsed: {fmt_seconds(statistics.median(vals))}")
    print("\nby role:")
    by_role = defaultdict(list)
    for r in rows:
        role = ((r.get("task_meta") or {}).get("family") or (r.get("run_meta") or {}).get("role") or "unknown")
        if elapsed(r):
            by_role[str(role)].append(elapsed(r))
    for role in sorted(by_role):
        vals = by_role[role]
        print(f"{role:<14} runs={len(vals):<3} total={fmt_seconds(sum(vals)):<8} avg={fmt_seconds(statistics.mean(vals))}")


def print_timeline(rows, n=20):
    print("\n=== timeline ===")
    for r in rows[-n:]:
        parts = token_parts(r)
        print(f"{r.get('run_id',''):<18} {status(r):4s} {r.get('task_id',''):<36} time={fmt_seconds(elapsed(r)):<6} total={parts['total']:<8} in={parts['input']:<8} out={parts['output']:<6} reason={parts['reasoning']}")


def print_notes(rows):
    print("\n=== notes ===")
    by = defaultdict(list)
    for r in rows:
        note = str(((r.get("run_meta") or {}).get("notes", "")) or "").strip() or "(empty)"
        by[note].append(r)
    for note in sorted(by):
        rs = by[note]
        passed = sum(1 for r in rs if r.get("score") == "pass")
        print(f"runs={len(rs):<3} pass={passed}/{len(rs):<3} notes={note}")


def delete_filtered_results(rows):
    print("\n=== delete results ===")
    if not notes_filter:
        print("[bench] refusing to delete without --notes <substring>", file=sys.stderr)
        raise SystemExit(2)
    if not rows:
        print(f"no graded result directories match notes filter: {notes_filter}")
        return

    print(f"notes filter: {notes_filter}")
    print(f"matches     : {len(rows)} graded result director{'y' if len(rows) == 1 else 'ies'}")
    if not yes_delete:
        print("mode        : dry-run (add --yes to delete)")
    else:
        print("mode        : delete")

    for r in rows:
        rel_dir = str(r.get("_dir", ""))
        target = (root / rel_dir).resolve()
        try:
            target.relative_to(results_dir.resolve())
        except ValueError:
            print(f"SKIP unsafe path: {rel_dir}", file=sys.stderr)
            continue
        if target == results_dir.resolve() or not target.is_dir():
            print(f"SKIP missing/invalid: {rel_dir}", file=sys.stderr)
            continue
        print(f"{'DELETE' if yes_delete else 'WOULD DELETE'} {rel_dir}  notes={((r.get('run_meta') or {}).get('notes', '') or '')}")
        if yes_delete:
            shutil.rmtree(target)


def print_run_detail(rows, q):
    r = find_run(rows, q)
    if not r:
        print(f"[bench] run not found or ambiguous: {q}", file=sys.stderr)
        raise SystemExit(1)
    print("=== run detail ===")
    print(f"run_id       : {r.get('run_id','')}")
    print(f"task_id      : {r.get('task_id','')}")
    score_value = str(r.get('score',''))
    score_display = color_pass_fail(score_value, score_value == 'pass') if score_value in {'pass', 'fail'} else score_value
    print(f"score        : {score_display}")
    score_numeric = r.get("score_numeric")
    if isinstance(score_numeric, (int, float)):
        print(f"score_numeric: {score_numeric:.4f}")
    print(f"rubric       : {format_rubric_summary(r.get('rubric'))}")
    print(f"result       : {r.get('_path','')}")
    print(f"artifacts    : {r.get('_dir','')}/artifacts/")
    meta = r.get("run_meta") or {}
    print(f"role         : {meta.get('role','')}")
    print(f"args         : {render_command_args(meta)}")
    if meta.get("target_role"):
        print(f"target       : {meta.get('target_role','')}")
    sessions = meta.get("pi_session_ids") or []
    print(f"sessions     : {', '.join(sessions) if sessions else 'none captured'}")
    print(f"extensions   : {render_extensions(meta)}")
    print(f"skills       : {meta.get('aux_skills_summary','')}")
    catalog_path = str(meta.get('catalog_path','') or '')
    config_root = str(Path(catalog_path).parent if catalog_path else '')
    print(f"config       : {config_root}")
    parts = token_parts(r)
    print(f"elapsed      : {fmt_seconds(elapsed(r))}")
    print(f"tokens       : total={parts['total']:,} input={parts['input']:,} output={parts['output']:,} reasoning={parts['reasoning']:,}")
    category_scores = r.get("category_scores") or {}
    if isinstance(category_scores, dict) and category_scores:
        print("categories:")
        for name in ("intelligence", "speed", "efficiency", "process"):
            value = category_scores.get(name)
            print(f"  {name}: {value:.4f}" if isinstance(value, (int, float)) else f"  {name}: n/a")

    efficiency_lines = format_efficiency_summary(TaskResult.from_json(root / r.get('_path', '')), results_dir)
    if efficiency_lines:
        print("\nefficiency:")
        for line in efficiency_lines:
            print(f"  {line}")

    checks = r.get("checks") or {}
    print("\nchecks:")
    if checks:
        for k, v in checks.items():
            print(f"  {k}: {v}")
    else:
        print("  none")

    orch_checks = r.get("orchestration_checks") or {}
    if orch_checks:
        print("\norchestration:")
        for key in sorted(orch_checks):
            print(f"  {key}: {orch_checks[key]}")
    warnings = orchestration_warnings(orch_checks)
    if warnings:
        print("\norchestration warnings:")
        for warning in warnings:
            print(f"  - {colorize(warning, 'red')}")

    orch = meta.get("orchestra_artifacts") or {}
    if orch:
        print("\norchestra artifacts:")
        for k, v in orch.items():
            print(f"  {k}: {v}")

rows = load_results()
if view == "dashboard":
    print_overview(rows); print_suites(rows); print_tasks(rows)
elif view == "runs":
    print_runs(rows, limit)
elif view == "run":
    print_run_detail(rows, run_query)
elif view == "tasks":
    print_tasks(rows)
elif view == "timeline":
    print_timeline(rows, limit)
elif view == "tokens":
    print_tokens(rows)
elif view == "timing":
    print_timing(rows)
elif view == "notes":
    print_notes(rows)
elif view == "delete":
    delete_filtered_results(rows)
else:
    print(f"unknown view: {view}", file=sys.stderr)
    raise SystemExit(1)
