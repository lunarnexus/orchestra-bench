# orchestra-bench environment config
# Copy to .env.local (not committed) for your own settings.

# Container / image settings
BENCH_IMAGE_NAME=orchestra-bench-env
CONTAINER_NAME=orchestra-bench-runner

# Target role in agent-catalog.yaml (defaults to builder)
BENCH_ROLE="builder"

# Orchestra on/off (true/false) — stored in run metadata
ORCHESTRA=true

# Extra skills to load (comma-separated skill names, e.g., "research-first,builder")
BENCH_EXTRA_SKILLS=""

# Free-form notes for this run session (stored in .bench_run.json and result.run_meta)
BENCH_NOTES=""

# Grading timeout in seconds
GRADING_TIMEOUT=120
